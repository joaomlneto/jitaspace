{
  "extends": "@jitaspace/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~/*": ["../web/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json"
  },
  "include": [".", ".storybook/*.ts", ".storybook/*.tsx"],
  "exclude": ["node_modules", "storybook-static"]
}
