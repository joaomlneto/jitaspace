{
  "name": "@jitaspace/eve-icons-gallery",
  "description": "Searchable gallery of @jitaspace/eve-icons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm copy-icons && next build",
    "clean": "rm -rf .turbo .next out node_modules public/icons",
    "copy-icons": "rm -rf public/icons && mkdir -p public && cp -R ../../packages/eve-icons/assets public/icons",
    "dev": "pnpm copy-icons && next dev",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "pnpm lint --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@jitaspace/eve-icons": "workspace:*",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@jitaspace/eslint-config": "workspace:*",
    "@jitaspace/prettier-config": "workspace:*",
    "@jitaspace/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "prettier": "@jitaspace/prettier-config"
}
