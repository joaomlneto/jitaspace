{
  "name": "@jitaspace/tiptap-eve",
  "description": "TipTap editor for EVE Online",
  "version": "0.1.6",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joaomlneto/jitaspace.git",
    "directory": "packages/tiptap-eve"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts --external react",
    "dev": "tsup index.ts --format cjs,esm --dts --external react --watch",
    "clean": "rm -rf .turbo node_modules dist",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "pnpm lint --fix",
    "prepack": "pnpm build",
    "test": "jest --config ./jest.config.ts --runInBand",
    "test:watch": "jest --config ./jest.config.ts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-hard-break": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0"
  },
  "peerDependencies": {
    "@tiptap/pm": "^3.33.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@jitaspace/eslint-config": "workspace:*",
    "@jitaspace/prettier-config": "workspace:*",
    "@jitaspace/tsconfig": "workspace:*",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@tiptap/pm": "^3.33.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.6",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "linkifyjs": "^4.4.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "prettier": "@jitaspace/prettier-config"
}
