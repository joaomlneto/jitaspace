// EVE Online manufacturing/research blueprints (from the SDE blueprints.yaml).
// A blueprint has one row per activity (manufacturing, copying, research, etc.),
// and each activity has its input materials, output products and required skills.
enum BlueprintActivityType {
  copying
  invention
  manufacturing
  reaction
  research_material
  research_time
}

model Blueprint {
  blueprintTypeId    Int                 @id
  blueprintType      Type                @relation("BlueprintType", fields: [blueprintTypeId], references: [typeId])
  maxProductionLimit Int
  activities         BlueprintActivity[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt()
  isDeleted          Boolean             @default(false)
}

model BlueprintActivity {
  blueprintTypeId Int
  blueprint       Blueprint             @relation(fields: [blueprintTypeId], references: [blueprintTypeId])
  activity        BlueprintActivityType
  time            Int
  materials       BlueprintMaterial[]
  products        BlueprintProduct[]
  skills          BlueprintSkill[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt()
  isDeleted       Boolean               @default(false)

  @@id([blueprintTypeId, activity])
}

model BlueprintMaterial {
  blueprintTypeId   Int
  activity          BlueprintActivityType
  blueprintActivity BlueprintActivity     @relation(fields: [blueprintTypeId, activity], references: [blueprintTypeId, activity])
  materialTypeId    Int
  materialType      Type                  @relation("BlueprintMaterials", fields: [materialTypeId], references: [typeId])
  quantity          Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt()
  isDeleted         Boolean               @default(false)

  @@id([blueprintTypeId, activity, materialTypeId])
  @@index([materialTypeId])
}

model BlueprintProduct {
  blueprintTypeId   Int
  activity          BlueprintActivityType
  blueprintActivity BlueprintActivity     @relation(fields: [blueprintTypeId, activity], references: [blueprintTypeId, activity])
  productTypeId     Int
  productType       Type                  @relation("BlueprintProducts", fields: [productTypeId], references: [typeId])
  quantity          Int
  // Probability of a successful invention run; only set for `invention` products.
  probability       Float?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt()
  isDeleted         Boolean               @default(false)

  @@id([blueprintTypeId, activity, productTypeId])
  @@index([productTypeId])
}

model BlueprintSkill {
  blueprintTypeId   Int
  activity          BlueprintActivityType
  blueprintActivity BlueprintActivity     @relation(fields: [blueprintTypeId, activity], references: [blueprintTypeId, activity])
  skillTypeId       Int
  skillType         Type                  @relation("BlueprintSkills", fields: [skillTypeId], references: [typeId])
  level             Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt()
  isDeleted         Boolean               @default(false)

  @@id([blueprintTypeId, activity, skillTypeId])
  @@index([skillTypeId])
}

// ---------------------------------------------------------------------------
// SDE tables ingested directly from the Static Data Export (no ESI equivalent)
// ---------------------------------------------------------------------------

/// Tech level / faction grouping for items (metaGroups.yaml).
model MetaGroup {
  metaGroupId Int      @id
  name        String
  description String?
  iconId      Int?
  iconSuffix  String?
  // RGB tint (0..1 floats) used to colour the meta-group badge; absent for some groups.
  colorR      Float?
  colorG      Float?
  colorB      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
  isDeleted   Boolean  @default(false)
}

/// Reprocessing / refining output of a type (typeMaterials.yaml `materials`).
model TypeMaterial {
  typeId         Int
  type           Type     @relation("TypeMaterialType", fields: [typeId], references: [typeId])
  materialTypeId Int
  materialType   Type     @relation("TypeMaterialMaterial", fields: [materialTypeId], references: [typeId])
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()
  isDeleted      Boolean  @default(false)

  @@id([typeId, materialTypeId])
  @@index([typeId])
  @@index([materialTypeId])
}

/// Per-faction contraband rules for a type (contrabandTypes.yaml).
model ContrabandType {
  typeId           Int
  type             Type     @relation(fields: [typeId], references: [typeId])
  factionId        Int
  faction          Faction  @relation(fields: [factionId], references: [factionId])
  attackMinSec     Float
  confiscateMinSec Float
  fineByValue      Float
  standingLoss     Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()
  isDeleted        Boolean  @default(false)

  @@id([typeId, factionId])
  @@index([typeId])
  @@index([factionId])
}

/// A mastery/competency certificate (certificates.yaml).
model Certificate {
  certificateId   Int                         @id
  name            String
  description     String
  groupId         Int
  skills          CertificateSkill[]
  recommendations CertificateRecommendation[]
  masteries       Mastery[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt()
  isDeleted       Boolean                     @default(false)

  @@index([groupId])
}

/// Required skill levels at each certificate grade (certificates.yaml `skillTypes`).
model CertificateSkill {
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [certificateId])
  skillTypeId   Int
  skillType     Type        @relation(fields: [skillTypeId], references: [typeId])
  basic         Int
  standard      Int
  improved      Int
  advanced      Int
  elite         Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([certificateId, skillTypeId])
  @@index([certificateId])
  @@index([skillTypeId])
}

/// Types a certificate is recommended for (certificates.yaml `recommendedFor`).
model CertificateRecommendation {
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [certificateId])
  typeId        Int
  type          Type        @relation(fields: [typeId], references: [typeId])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([certificateId, typeId])
  @@index([certificateId])
  @@index([typeId])
}

/// Certificates earned by a type at each mastery level 0..4 (masteries.yaml).
model Mastery {
  typeId        Int
  type          Type        @relation(fields: [typeId], references: [typeId])
  masteryLevel  Int
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [certificateId])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([typeId, masteryLevel, certificateId])
  @@index([typeId])
  @@index([certificateId])
}

/// A SKIN material / colour set (skinMaterials.yaml).
model SkinMaterial {
  skinMaterialId Int      @id
  displayName    String?
  /// Points at GraphicMaterialSet.materialSetId, but deliberately NOT a declared
  /// relation: the column is required, so a dangling upstream reference would
  /// fail the whole skinMaterials ingest — and skipping the row would then break
  /// Skin.skinMaterialId, which foreign-keys it.
  materialSetId  Int
  skins          Skin[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()
  isDeleted      Boolean  @default(false)

  @@index([materialSetId])
}

/// A ship/structure SKIN (skins.yaml).
model Skin {
  skinId             Int           @id
  skinMaterialId     Int
  skinMaterial       SkinMaterial  @relation(fields: [skinMaterialId], references: [skinMaterialId])
  internalName       String
  allowCcpDevs       Boolean
  isStructureSkin    Boolean?
  visibleSerenity    Boolean
  visibleTranquility Boolean
  types              SkinType[]
  licenses           SkinLicense[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt()
  isDeleted          Boolean       @default(false)

  @@index([skinMaterialId])
}

/// Types a SKIN can be applied to (skins.yaml `types`).
model SkinType {
  skinId    Int
  skin      Skin     @relation(fields: [skinId], references: [skinId])
  typeId    Int
  type      Type     @relation(fields: [typeId], references: [typeId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([skinId, typeId])
  @@index([skinId])
  @@index([typeId])
}

/// A SKIN license item that grants a SKIN (skinLicenses.yaml).
model SkinLicense {
  licenseTypeId Int      @id
  skinId        Int
  skin          Skin     @relation(fields: [skinId], references: [skinId])
  duration      Int
  isSingleUse   Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt()
  isDeleted     Boolean  @default(false)

  @@index([skinId])
}

/// What a TypeListEntry points at (type / group / category).
enum TypeListRefType {
  type
  group
  category
}

/// A named set of types defined by include/exclude rules (typeLists.yaml).
model TypeList {
  typeListId         Int             @id
  name               String
  displayName        String?
  displayDescription String?
  entries            TypeListEntry[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt()
  isDeleted          Boolean         @default(false)
}

/// One include/exclude membership rule of a TypeList. `refId` is polymorphic
/// (a type, group, or category id per `refType`), so it has no foreign key.
model TypeListEntry {
  typeListId Int
  typeList   TypeList        @relation(fields: [typeListId], references: [typeListId])
  included   Boolean
  refType    TypeListRefType
  refId      Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt()
  isDeleted  Boolean         @default(false)

  @@id([typeListId, included, refType, refId])
  @@index([typeListId])
}

/// An NPC corporation activity category (corporationActivities.yaml).
model CorporationActivity {
  corporationActivityId Int      @id
  name                  String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt()
  isDeleted             Boolean  @default(false)
}

/// A Mercenary Den tactical operation (mercenaryTacticalOperations.yaml).
model MercenaryTacticalOperation {
  mercenaryTacticalOperationId Int      @id
  name                         String
  description                  String
  // The dungeon this operation runs in. dungeons.yaml is not ingested, so this
  // is a plain id with no foreign key.
  dungeonId                    Int
  anarchyImpact                Int
  developmentImpact            Int
  infomorphBonus               Int
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt()
  isDeleted                    Boolean  @default(false)
}

/// A freelance job schema (freelanceJobSchemas.yaml). Only the descriptive
/// fields and content tags are modelled; the deep `parameters` / contribution
/// tuning config is not.
model FreelanceJobSchema {
  freelanceJobSchemaGroupId              Int
  name                                   String
  title                                  String?
  description                            String?
  iconId                                 String?
  progressDescription                    String?
  rewardDescription                      String?
  targetDescription                      String?
  /// Contribution-tuning limits a job poster can set. Each is a labelled
  /// descriptor in the SDE — a title/description/icon plus, for some, numeric
  /// bounds — so each is flattened the same way here.
  /// `maxContributionsPerParticipant` is on all ten schemas;
  /// `contributionMultiplier` and `maxProgressPerContribution` only on
  /// ShipInsurance.
  maxContributionsTitle                  String?
  maxContributionsDescription            String?
  maxContributionsUnsetDescription       String?
  maxContributionsIconId                 String?
  /// `contributionMultiplier.defaultValue`, with its `minValue` / `maxValue`
  /// bounds — the SDE offers a range, not a single figure.
  contributionMultiplier                 Float?
  contributionMultiplierMin              Float?
  contributionMultiplierMax              Float?
  contributionMultiplierTitle            String?
  contributionMultiplierDescription      String?
  contributionMultiplierUnsetDescription String?
  contributionMultiplierIconId           String?
  /// `maxProgressPerContribution` carries NO numeric leaf at all — only the
  /// labels — so there is deliberately no Float column for it.
  maxProgressTitle                       String?
  maxProgressDescription                 String?
  maxProgressUnsetDescription            String?
  maxProgressIconId                      String?
  parameters                             FreelanceJobSchemaParameter[]
  tags                                   FreelanceJobSchemaTag[]
  createdAt                              DateTime                      @default(now())
  updatedAt                              DateTime                      @updatedAt()
  isDeleted                              Boolean                       @default(false)

  @@id([freelanceJobSchemaGroupId, name])
}

/// One content tag of a freelance job schema (freelanceJobSchemas.yaml `contentTags`).
model FreelanceJobSchemaTag {
  freelanceJobSchemaGroupId Int
  name                      String
  schema                    FreelanceJobSchema @relation(fields: [freelanceJobSchemaGroupId, name], references: [freelanceJobSchemaGroupId, name])
  tag                       String
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt()
  isDeleted                 Boolean            @default(false)

  @@id([freelanceJobSchemaGroupId, name, tag])
  @@index([freelanceJobSchemaGroupId, name])
}

// ---------------------------------------------------------------------------
// Further SDE reference tables. Cross-entity references (types, attributes,
// factions, groups, skills) are stored as plain integer ids without foreign
// keys, to keep these niche tables from adding back-relations to the `Type`
