model KillmailVictimItems {
  /**
   * The killmail ID of the killmail this item was involved in.
   */
  killmailId        BigInt
  /**
   * The index of this item in the list of items involved in the killmail.
   */
  itemIndex         Int
  /**
   * The parent/container item index of this item, or null if this item is not contained within another item.
   */
  parentItemIndex   Int?
  /**
   * Flag for the location of the item
   */
  flag              Int
  /**
   * The type ID of the item.
   */
  typeId            Int
  /**
   * How many of the item were destroyed, if any
   */
  quantityDestroyed Int?
  /**
   * How many of the item were dropped, if any
   */
  quantityDropped   Int?
  /**
   * The unique ID of the item, if it was a singleton.
   */
  singleton         BigInt
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt()
  isDeleted         Boolean  @default(false)

  killmailVictim KillmailVictim        @relation("KillmailVictimItems", fields: [killmailId], references: [killmailId])
  parentItem     KillmailVictimItems?  @relation("KillmailVictimItemParent", fields: [killmailId, parentItemIndex], references: [killmailId, itemIndex])
  childItems     KillmailVictimItems[] @relation("KillmailVictimItemParent")
  type           Type                  @relation("KillmailVictimItemType", fields: [typeId], references: [typeId])

  @@id([killmailId, itemIndex])
  @@index([typeId])
  @@index([killmailId])
  @@index([killmailId, parentItemIndex])
}

