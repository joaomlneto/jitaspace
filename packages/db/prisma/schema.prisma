// TODO add position,
model SolarSystem {
  solarSystemId              Int                                   @id
  name                       String
  stations                   Station[]
  constellation              Constellation                         @relation(fields: [constellationId], references: [constellationId])
  constellationId            Int
  securityClass              String?
  securityStatus             Decimal
  star                       Star?                                 @relation("SolarSystemStar")
  starId                     Int?
  stargates                  Stargate[]                            @relation("SolarSystemStargate")
  // SDE-only columns, owned by ingestSdeSolarSystems.
  wormholeClassId            Int?
  visualEffect               String?
  isRegional                 Boolean?
  isInternational            Boolean?
  isHub                      Boolean?
  isBorder                   Boolean?
  isFringe                   Boolean?
  isCorridor                 Boolean?
  luminosity                 Float?
  radius                     Float?
  /// The system's galactic coordinates (mapSolarSystems.yaml `position`).
  positionX                  Float?
  positionY                  Float?
  positionZ                  Float?
  /// The system's position on the 2D star map (mapSolarSystems.yaml `position2D`).
  /// Float, not BigInt: CCP ships values beyond 2^53 (e.g. 69851821507953890), so
  /// the YAML parse has already rounded them to a double before we see them.
  position2dX                Float?
  position2dY                Float?
  disallowedAnchorCategories SolarSystemDisallowedAnchorCategory[]
  disallowedAnchorGroups     SolarSystemDisallowedAnchorGroup[]
  // The faction that holds the system. Distinct from `solarSystemFactions`
  // below, which is the inverse of Faction.solarSystemId (a faction's home
  // system).
  faction                    Faction?                              @relation("SolarSystemFaction", fields: [factionId], references: [factionId])
  factionId                  Int?
  /**
