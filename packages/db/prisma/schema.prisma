/// Sparse planetary colony resource of a planet (planetResources.yaml). Each
/// planet provides exactly one of power / workforce / a reagent.
model PlanetResource {
  planetId                 Int      @id
  power                    Int?
  workforce                Int?
  reagentTypeId            Int?
  reagentAmountPerCycle    Int?
  reagentCyclePeriod       Int?
  reagentSecuredCapacity   Int?
  reagentUnsecuredCapacity Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt()
  isDeleted                Boolean  @default(false)
}

/// What a TypeBonusLine applies to.
enum TypeBonusKind {
  role
  skill
  misc
}

/// Per-type trait/bonus header (typeBonus.yaml).
model TypeBonus {
  typeId    Int             @id
  iconId    Int?
  lines     TypeBonusLine[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt()
  isDeleted Boolean         @default(false)
}

/// One trait/bonus line of a type (typeBonus.yaml role/skill/misc bonuses).
/// `skillTypeId` is 0 for role and misc bonuses; `sequence` preserves order.
model TypeBonusLine {
  typeId      Int
  typeBonus   TypeBonus     @relation(fields: [typeId], references: [typeId])
  kind        TypeBonusKind
  skillTypeId Int
  sequence    Int
  bonus       Float?
  bonusText   String?
  importance  Int?
  unitId      Int?
  /// Whether a misc trait line is an upside or a drawback (typeBonus.yaml
  /// `miscBonuses[].isPositive`). Only ever set on `misc` lines.
  isPositive  Boolean?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt()
  isDeleted   Boolean       @default(false)

  @@id([typeId, kind, skillTypeId, sequence])
  @@index([typeId])
}

/// A control tower (POS) fuel/resource requirement line (controlTowerResources.yaml).
/// `sequence` preserves order (a resourceTypeId can repeat across factions).
model ControlTowerResource {
  controlTowerTypeId Int
  sequence           Int
  purpose            Int
  quantity           Int
  resourceTypeId     Int
  factionId          Int?
  minSecurityLevel   Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt()
  isDeleted          Boolean  @default(false)

  @@id([controlTowerTypeId, sequence])
}

/// A mutaplasmid (dynamicItemAttributes.yaml) — the entity set; ranges and
/// type mappings live in the child tables.
model DynamicItemAttribute {
  mutaplasmidTypeId Int                           @id
  ranges            DynamicItemAttributeRange[]
  mappings          DynamicItemAttributeMapping[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt()
  isDeleted         Boolean                       @default(false)
}

/// The min/max range a mutaplasmid rolls for a dogma attribute.
model DynamicItemAttributeRange {
  mutaplasmidTypeId Int
  mutaplasmid       DynamicItemAttribute @relation(fields: [mutaplasmidTypeId], references: [mutaplasmidTypeId])
  attributeId       Int
  min               Float
  max               Float
  /// Per-mutaplasmid override of the attribute's good/bad polarity
  /// (dynamicItemAttributes.yaml `attributeIDs.<id>.highIsGood`).
  highIsGood        Boolean?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt()
  isDeleted         Boolean              @default(false)

  @@id([mutaplasmidTypeId, attributeId])
}

/// Which base type a mutaplasmid applies to and what it produces.
model DynamicItemAttributeMapping {
  mutaplasmidTypeId Int
  mutaplasmid       DynamicItemAttribute @relation(fields: [mutaplasmidTypeId], references: [mutaplasmidTypeId])
  resultingTypeId   Int
  applicableTypeId  Int
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt()
  isDeleted         Boolean              @default(false)

  @@id([mutaplasmidTypeId, resultingTypeId, applicableTypeId])
}

/// What a DbuffModifier targets.
enum DbuffModifierKind {
  item
  location
  locationGroup
  locationRequiredSkill
}

/// A dynamic buff collection (dbuffCollections.yaml).
model DbuffCollection {
  dbuffCollectionId    Int             @id
  aggregateMode        String
  developerDescription String
  displayName          String?
  operationName        String
  showOutputValueInUI  String
  modifiers            DbuffModifier[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt()
  isDeleted            Boolean         @default(false)
}

/// One modifier of a dbuff collection. `groupId`/`skillId` are set only for the
/// locationGroup / locationRequiredSkill kinds; `sequence` preserves order.
model DbuffModifier {
  dbuffCollectionId Int
  dbuffCollection   DbuffCollection   @relation(fields: [dbuffCollectionId], references: [dbuffCollectionId])
  kind              DbuffModifierKind
  sequence          Int
  dogmaAttributeId  Int
  groupId           Int?
  skillId           Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt()
  isDeleted         Boolean           @default(false)

  @@id([dbuffCollectionId, kind, sequence])
}

/// A planetary-industry production schematic (planetSchematics.yaml).
model PlanetSchematic {
  planetSchematicId Int                   @id
  name              String
  cycleTime         Int
  types             PlanetSchematicType[]
  pins              PlanetSchematicPin[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt()
  isDeleted         Boolean               @default(false)
}

/// An input/output material of a planetary schematic.
model PlanetSchematicType {
  planetSchematicId Int
  planetSchematic   PlanetSchematic @relation(fields: [planetSchematicId], references: [planetSchematicId])
  typeId            Int
  isInput           Boolean
  quantity          Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt()
  isDeleted         Boolean         @default(false)

  @@id([planetSchematicId, typeId])
}

/// A pin (structure) type usable for a planetary schematic.
model PlanetSchematicPin {
  planetSchematicId Int
  planetSchematic   PlanetSchematic @relation(fields: [planetSchematicId], references: [planetSchematicId])
  pinTypeId         Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt()
  isDeleted         Boolean         @default(false)

  @@id([planetSchematicId, pinTypeId])
}

/// A dungeon / encounter site definition (dungeons.yaml).
model Dungeon {
  dungeonId           Int                  @id
  name                String
  description         String?
  gameplayDescription String?
  archetypeId         Int
  factionId           Int?
  allowedShips        DungeonAllowedShip[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt()
  isDeleted           Boolean              @default(false)

  @@index([archetypeId])
}

/// A ship type allowed to enter a dungeon (dungeons.yaml `allowedShipsList`).
model DungeonAllowedShip {
  dungeonId  Int
  dungeon    Dungeon  @relation(fields: [dungeonId], references: [dungeonId])
  shipTypeId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt()
  isDeleted  Boolean  @default(false)

  @@id([dungeonId, shipTypeId])
}

/// An Alpha-clone skill grade (cloneGrades.yaml).
model CloneGrade {
  cloneGradeId Int               @id
  name         String
  skills       CloneGradeSkill[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt()
  isDeleted    Boolean           @default(false)
}

/// The level cap a clone grade grants for a skill (cloneGrades.yaml `skills`).
model CloneGradeSkill {
  cloneGradeId Int
  cloneGrade   CloneGrade @relation(fields: [cloneGradeId], references: [cloneGradeId])
  skillTypeId  Int
  level        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt()
  isDeleted    Boolean    @default(false)

  @@id([cloneGradeId, skillTypeId])
}

/// A station operation type (stationOperations.yaml). The `operationName` is also
/// used (by the stations ingest) to build `Station.name`; this captures the full
/// operation definition. Cross-entity ids are plain integers (no foreign keys).
model StationOperation {
  stationOperationId  Int                           @id
  activityId          Int
  operationName       String
  description         String?
  border              Float
  corridor            Float
  fringe              Float
  hub                 Float
  ratio               Float
  manufacturingFactor Float
  researchFactor      Float
  services            StationOperationService[]
  stationTypes        StationOperationStationType[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt()
  isDeleted           Boolean                       @default(false)
}

/// A service offered by a station operation (stationOperations.yaml `services`).
model StationOperationService {
  stationOperationId Int
  stationOperation   StationOperation @relation(fields: [stationOperationId], references: [stationOperationId])
  serviceId          Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt()
  isDeleted          Boolean          @default(false)

  @@id([stationOperationId, serviceId])
}

/// The station type used per race for a station operation
/// (stationOperations.yaml `stationTypes`).
model StationOperationStationType {
  stationOperationId Int
  stationOperation   StationOperation @relation(fields: [stationOperationId], references: [stationOperationId])
  raceId             Int
  stationTypeId      Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt()
  isDeleted          Boolean          @default(false)

  @@id([stationOperationId, raceId])
}

// ---------------------------------------------------------------------------
// Agent missions and epic arcs (missions.yaml, epicArcs.yaml)
//
// Cross-entity ids here are plain Int columns rather than relations, matching
// StationOperationService.serviceId / StationOperationStationType.stationTypeId:
// these SDE tables reference a wide spread of entities, and a relation per id
// would need a back-relation on every referenced model.
// ---------------------------------------------------------------------------

/// An agent mission (missions.yaml). The single-object `killMission`,
/// `courierMission` and `missionRewards` sub-objects are flattened into
/// prefixed columns, as MetaGroup does for `color`.
model Mission {
  missionId                            Int                    @id
  name                                 String
  /// factions.yaml id of the mission's faction.
  factionId                            Int?
  /// npcCorporations.yaml id of the offering corporation.
  corporationId                        Int?
  /// agentTypes.yaml id.
  agentTypeId                          Int?
  expirationTime                       Int?
  hasStandingRewards                   Boolean?
  /// types.yaml id of the gift handed over when the mission is offered.
  initialAgentGiftTypeId               Int?
  initialAgentGiftQuantity             Int?
  // killMission.*
  killDungeonId                        Int?
  killObjectiveTypeId                  Int?
  killObjectiveQuantity                Int?
  /// Despite the name, `killMission.dropItemInMissionContainer` is a types.yaml
  /// id (the item dropped in the mission container), never a boolean.
  killDropItemInMissionContainerTypeId Int?
  // courierMission.*
  courierObjectiveTypeId               Int?
  courierObjectiveQuantity             Int?
  courierObjectiveSingleton            Boolean?
  // missionRewards.*
  rewardTypeId                         Int?
  rewardQuantity                       Int?
  bonusRewardTypeId                    Int?
  bonusRewardQuantity                  Int?
  bonusTimeInterval                    Int?
  messages                             MissionMessage[]
  extraStandings                       MissionExtraStanding[]
  epicArcMissions                      EpicArcMission[]
  createdAt                            DateTime               @default(now())
  updatedAt                            DateTime               @updatedAt()
  isDeleted                            Boolean                @default(false)

  @@index([factionId])
  @@index([corporationId])
}

/// One localized message slot on a mission (missions.yaml `messages`), keyed by
/// its dotted message id (e.g. `messages.mission.briefing`). English text only,
/// like every other localized column in this schema.
model MissionMessage {
  missionId Int
  mission   Mission  @relation(fields: [missionId], references: [missionId])
  key       String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([missionId, key])
}

/// Extra standing gained with a third-party faction (missions.yaml
/// `extraStandings`), keyed by that faction's id.
model MissionExtraStanding {
  missionId Int
  mission   Mission  @relation(fields: [missionId], references: [missionId])
  factionId Int
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([missionId, factionId])
}

/// An epic arc — a branching chain of missions (epicArcs.yaml).
model EpicArc {
  epicArcId          Int              @id
  name               String
  /// factions.yaml id.
  factionId          Int?
  /// icons.yaml id.
  iconId             Int?
  arcRestartInterval Int?
  missions           EpicArcMission[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt()
  isDeleted          Boolean          @default(false)

  @@index([factionId])
}

/// A mission's node in an epic arc (epicArcs.yaml `missions`).
model EpicArcMission {
  epicArcId     Int
  epicArc       EpicArc              @relation(fields: [epicArcId], references: [epicArcId])
  missionId     Int
  mission       Mission              @relation(fields: [missionId], references: [missionId])
  /// npcCharacters.yaml id of the agent offering this step.
  agentId       Int?
  failMissionId Int?
  nextMissions  EpicArcMissionNext[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt()
  isDeleted     Boolean              @default(false)

  @@id([epicArcId, missionId])
  @@index([missionId])
}

/// An outgoing edge in the epic-arc mission graph
/// (epicArcs.yaml `missions.*.nextMissions`).
model EpicArcMissionNext {
  epicArcId      Int
  missionId      Int
  epicArcMission EpicArcMission @relation(fields: [epicArcId, missionId], references: [epicArcId, missionId])
  nextMissionId  Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt()
  isDeleted      Boolean        @default(false)

  @@id([epicArcId, missionId, nextMissionId])
}

// ---------------------------------------------------------------------------
// Ship tree (shipTreeElements/Factions/Groups.yaml, typeElements.yaml)
//
// The "elements" maps are `slot -> shipTreeElementID`: an ordered list of the
// attributes shown for a group/faction/type in the in-game ship tree. The map
// key is kept as `slot` so ordering survives.
// ---------------------------------------------------------------------------

/// A ship-tree attribute such as Armor or Shield (shipTreeElements.yaml).
model ShipTreeElement {
  shipTreeElementId Int      @id
  name              String
  description       String?
  icon              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt()
  isDeleted         Boolean  @default(false)
}

/// Per-faction ship-tree presentation (shipTreeFactions.yaml), keyed by faction.
model ShipTreeFaction {
  factionId   Int                      @id
  description String?
  icon        String?
  elements    ShipTreeFactionElement[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt()
  isDeleted   Boolean                  @default(false)
}

/// An element shown for a faction (shipTreeFactions.yaml `elements`).
model ShipTreeFactionElement {
  factionId         Int
  shipTreeFaction   ShipTreeFaction @relation(fields: [factionId], references: [factionId])
  slot              Int
  shipTreeElementId Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt()
  isDeleted         Boolean         @default(false)

  @@id([factionId, slot])
}

/// A ship-tree group such as Corvette or Cruiser (shipTreeGroups.yaml). This is
/// the id `Type.shipTreeGroupId` points at.
model ShipTreeGroup {
  shipTreeGroupId Int                        @id
  name            String
  description     String?
  icon            String?
  iconLarge       String?
  iconSmall       String?
  iconSmallNpc    String?
  elements        ShipTreeGroupElement[]
  preReqSkills    ShipTreeGroupPreReqSkill[]
  tierThresholds  SkinrTierThreshold[]
  types           Type[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt()
  isDeleted       Boolean                    @default(false)
}

/// An element shown for a ship-tree group (shipTreeGroups.yaml `elements`).
model ShipTreeGroupElement {
  shipTreeGroupId   Int
  shipTreeGroup     ShipTreeGroup @relation(fields: [shipTreeGroupId], references: [shipTreeGroupId])
  slot              Int
  shipTreeElementId Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt()
  isDeleted         Boolean       @default(false)

  @@id([shipTreeGroupId, slot])
}

/// A skill prerequisite for a ship-tree group, per faction
/// (shipTreeGroups.yaml `preReqSkills.<factionID>.skills.<typeID>`).
model ShipTreeGroupPreReqSkill {
  shipTreeGroupId Int
  shipTreeGroup   ShipTreeGroup @relation(fields: [shipTreeGroupId], references: [shipTreeGroupId])
  factionId       Int
  skillTypeId     Int
  level           Int?
  display         Boolean?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt()
  isDeleted       Boolean       @default(false)

  @@id([shipTreeGroupId, factionId, skillTypeId])
}

/// The ship-tree elements shown for a specific type (typeElements.yaml).
model TypeElement {
  typeId            Int
  slot              Int
  shipTreeElementId Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt()
  isDeleted         Boolean  @default(false)

  @@id([typeId, slot])
}

// ---------------------------------------------------------------------------
// Graphic material sets (graphicMaterialSets.yaml)
// ---------------------------------------------------------------------------

/// A Space-Object-Factory material set — the hull/pattern materials and tint
/// colours applied to a ship graphic. This is the id `Graphic.sofMaterialSetId`
/// and `SkinMaterial.materialSetId` point at. The four RGBA colour objects are
/// flattened into prefixed columns, as MetaGroup does for `color`.
model GraphicMaterialSet {
  materialSetId   Int       @id
  description     String?
  sofFactionName  String?
  sofRaceHint     String?
  sofPatternName  String?
  resPathInsert   String?
  material1       String?
  material2       String?
  material3       String?
  material4       String?
  customMaterial1 String?
  customMaterial2 String?
  colorHullR      Float?
  colorHullG      Float?
  colorHullB      Float?
  colorHullA      Float?
  colorPrimaryR   Float?
  colorPrimaryG   Float?
  colorPrimaryB   Float?
  colorPrimaryA   Float?
  colorSecondaryR Float?
  colorSecondaryG Float?
  colorSecondaryB Float?
  colorSecondaryA Float?
  colorWindowR    Float?
  colorWindowG    Float?
  colorWindowB    Float?
  colorWindowA    Float?
  graphics        Graphic[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt()
  isDeleted       Boolean   @default(false)
}

// ---------------------------------------------------------------------------
// Military campaigns (militaryCampaigns.yaml, militaryCampaignObjectives.yaml)
//
// Both files are keyed by UUID, so the primary keys are String.
// ---------------------------------------------------------------------------

/// A faction military campaign (militaryCampaigns.yaml).
model MilitaryCampaign {
  militaryCampaignId String                       @id
  title              String
  subtitle           String?
  /// BigInt, not Int: progress is counted in whatever unit the objectives
  /// contribute in, and the ISK-denominated ones run well past int4 (see
  /// MilitaryCampaignObjective.targetProgress).
  targetProgress     BigInt?
  /// factions.yaml id of the issuing faction (`issuer.factionID`).
  issuerFactionId    Int?
  annotations        MilitaryCampaignAnnotation[]
  objectives         MilitaryCampaignObjective[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt()
  isDeleted          Boolean                      @default(false)
}

/// A presentation annotation on a campaign (militaryCampaigns.yaml
/// `annotations`). CCP ships ~44 of these per campaign — mostly `res:/…` asset
/// paths plus a few localized blurbs — and adds more over time, so they are
/// stored key/value (English text for localized entries) rather than as one
/// column per key.
model MilitaryCampaignAnnotation {
  militaryCampaignId String
  militaryCampaign   MilitaryCampaign @relation(fields: [militaryCampaignId], references: [militaryCampaignId])
  key                String
  value              String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt()
  isDeleted          Boolean          @default(false)

  @@id([militaryCampaignId, key])
}

/// One objective within a campaign (militaryCampaignObjectives.yaml). The
/// `rewards` and `annotations` sub-objects have a small fixed key set, so they
/// are flattened into prefixed columns.
model MilitaryCampaignObjective {
  militaryCampaignObjectiveId     String                               @id
  title                           String
  subtitle                        String?
  /// militaryCampaigns.yaml id (`campaignID`).
  militaryCampaignId              String
  militaryCampaign                MilitaryCampaign                     @relation(fields: [militaryCampaignId], references: [militaryCampaignId])
  careerPath                      String?
  /// BigInt, not Int: an objective's progress is counted in the raw unit its
  /// contribution method reports — number of missions for "CompleteAgentMission",
  /// but ISK for the value-denominated ones — so the targets run past int4.
  /// Ingesting them as `Int` failed the job with "integer out of range for
  /// type int4".
  targetProgress                  BigInt?
  maxProgressPerParticipant       BigInt?
  /// npcCharacters.yaml id.
  presentingCharacterId           Int?
  /// npcCorporations.yaml id (`issuer.corporationID`).
  issuerCorporationId             Int?
  // rewards.isk / rewards.lp / rewards.standing. The `*ProgressInterval`
  // columns are measured in the same unit as `targetProgress` above ("pay
  // `amountPerInterval` for every `progressInterval` of progress"), so they
  // are BigInt for the same reason.
  iskAmountPerInterval            Float?
  iskProgressInterval             BigInt?
  iskIssuerCorporationId          Int?
  lpAmountPerInterval             Float?
  lpProgressInterval              BigInt?
  lpIssuerCorporationId           Int?
  standingGainPercentPerInterval  Float?
  standingProgressInterval        BigInt?
  /// The standing reward's issuer is a FACTION, not a corporation: CCP ships
  /// `rewards.standing.issuer.factionID` (isk/lp use `issuer.corporationID`).
  standingIssuerFactionId         Int?
  // annotations.*
  requiredEnlistmentWithFactionId Int?
  restrictionTooltip              String?
  warning1                        String?
  warning2                        String?
  /// contributionMethodConfiguration.name, e.g. "CompleteAgentMission".
  contributionMethodName          String?
  contentTags                     MilitaryCampaignObjectiveTag[]
  parameters                      MilitaryCampaignObjectiveParameter[]
  createdAt                       DateTime                             @default(now())
  updatedAt                       DateTime                             @updatedAt()
  isDeleted                       Boolean                              @default(false)

  @@index([militaryCampaignId])
}

/// A content tag on an objective (militaryCampaignObjectives.yaml `contentTags`).
model MilitaryCampaignObjectiveTag {
  militaryCampaignObjectiveId String
  objective                   MilitaryCampaignObjective @relation(fields: [militaryCampaignObjectiveId], references: [militaryCampaignObjectiveId])
  tag                         String
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt()
  isDeleted                   Boolean                   @default(false)

  @@id([militaryCampaignObjectiveId, tag])
}

/// A parameter of an objective's contribution method
/// (`contributionMethodConfiguration.parameters[].key`).
model MilitaryCampaignObjectiveParameter {
  militaryCampaignObjectiveId String
  objective                   MilitaryCampaignObjective                 @relation(fields: [militaryCampaignObjectiveId], references: [militaryCampaignObjectiveId])
  paramKey                    String
  matcherValues               MilitaryCampaignObjectiveParameterValue[]
  createdAt                   DateTime                                  @default(now())
  updatedAt                   DateTime                                  @updatedAt()
  isDeleted                   Boolean                                   @default(false)

  @@id([militaryCampaignObjectiveId, paramKey])
}

/// One matcher value for a contribution-method parameter
/// (`parameters[].matcher.values[]`). Ordinal keys, like
/// DogmaEffectModifier.modifierIndex: a matcher entry can carry a `valueType`
/// with no `values`, so neither field is safe as part of the key.
model MilitaryCampaignObjectiveParameterValue {
  militaryCampaignObjectiveId String
  paramKey                    String
  parameter                   MilitaryCampaignObjectiveParameter @relation(fields: [militaryCampaignObjectiveId, paramKey], references: [militaryCampaignObjectiveId, paramKey])
  matcherIndex                Int
  valueIndex                  Int
  valueType                   String
  value                       String?
  createdAt                   DateTime                           @default(now())
  updatedAt                   DateTime                           @updatedAt()
  isDeleted                   Boolean                            @default(false)

  @@id([militaryCampaignObjectiveId, paramKey, matcherIndex, valueIndex])
}

// ---------------------------------------------------------------------------
// SKINR — the in-game SKIN designer (skinr*.yaml, 9 files)
//
// Components (materials/patterns) are placed into slots; a slot configuration
// says which slots a hull exposes. Point values and tier thresholds drive the
// designer's cost/tier maths, and are keyed by (category, rarity) and
// (shipTreeGroup, tier) respectively — the SDE ships them as bare numeric maps.
// ---------------------------------------------------------------------------

/// A SKINR component category — Material, Pattern, Metallic
/// (skinrComponentCategories.yaml). `name` is a plain internal string here.
model SkinrComponentCategory {
  skinrComponentCategoryId Int                        @id
  name                     String
  components               SkinrComponent[]
  pointValues              SkinrComponentPointValue[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt()
  isDeleted                Boolean                    @default(false)
}

/// A SKINR component rarity tier (skinrComponentRarities.yaml).
model SkinrComponentRarity {
  skinrComponentRarityId Int                        @id
  name                   String
  rank                   Int?
  components             SkinrComponent[]
  pointValues            SkinrComponentPointValue[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt()
  isDeleted              Boolean                    @default(false)
}

/// Designer point cost per (category, rarity) (skinrComponentPointValues.yaml,
/// a bare `rarity -> points` map keyed by category).
model SkinrComponentPointValue {
  skinrComponentCategoryId Int
  category                 SkinrComponentCategory @relation(fields: [skinrComponentCategoryId], references: [skinrComponentCategoryId])
  skinrComponentRarityId   Int
  rarity                   SkinrComponentRarity   @relation(fields: [skinrComponentRarityId], references: [skinrComponentRarityId])
  points                   Int
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt()
  isDeleted                Boolean                @default(false)

  @@id([skinrComponentCategoryId, skinrComponentRarityId])
  @@index([skinrComponentRarityId])
}

/// A SKINR component — one material or pattern (skinrComponents.yaml). The
/// `sequenceBinder` sub-object is flattened into prefixed columns.
model SkinrComponent {
  skinrComponentId         Int                    @id
  name                     String
  skinrComponentCategoryId Int
  category                 SkinrComponentCategory @relation(fields: [skinrComponentCategoryId], references: [skinrComponentCategoryId])
  skinrComponentRarityId   Int
  rarity                   SkinrComponentRarity   @relation(fields: [skinrComponentRarityId], references: [skinrComponentRarityId])
  published                Boolean?
  finish                   String?
  iconFile                 String?
  resourceFile             String?
  projectionTypeU          String?
  projectionTypeV          String?
  /// sequenceBinder.itemTypeID / .count — the item and quantity consumed.
  sequenceBinderItemTypeId Int?
  sequenceBinderCount      Int?
  associatedTypes          SkinrComponentType[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt()
  isDeleted                Boolean                @default(false)

  @@index([skinrComponentCategoryId])
  @@index([skinrComponentRarityId])
}

/// A type that grants/uses a SKINR component
/// (skinrComponents.yaml `associatedTypeIds[]`).
model SkinrComponentType {
  skinrComponentId   Int
  skinrComponent     SkinrComponent @relation(fields: [skinrComponentId], references: [skinrComponentId])
  typeId             Int
  /// -1 means unlimited uses.
  licenseUsesGranted Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt()
  isDeleted          Boolean        @default(false)

  @@id([skinrComponentId, typeId])
}

/// A SKINR slot category (skinrSlotCategories.yaml).
model SkinrSlotCategory {
  skinrSlotCategoryId Int         @id
  name                String
  slots               SkinrSlot[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt()
  isDeleted           Boolean     @default(false)
}

/// An internal slot name (skinrSlotNames.yaml), e.g. `primary_nanocoating`.
model SkinrSlotName {
  skinrSlotNameId Int      @id
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt()
  isDeleted       Boolean  @default(false)
}

/// A SKINR slot (skinrSlots.yaml).
model SkinrSlot {
  skinrSlotId                Int                          @id
  name                       String
  skinrSlotCategoryId        Int?
  category                   SkinrSlotCategory?           @relation(fields: [skinrSlotCategoryId], references: [skinrSlotCategoryId])
  allowedComponentCategories SkinrSlotAllowedCategory[]
  configurationSlots         SkinrSlotConfigurationSlot[]
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt()
  isDeleted                  Boolean                      @default(false)

  @@index([skinrSlotCategoryId])
}

/// A component category a slot accepts
/// (skinrSlots.yaml `allowedDesignComponentCategories[]`).
model SkinrSlotAllowedCategory {
  skinrSlotId              Int
  skinrSlot                SkinrSlot @relation(fields: [skinrSlotId], references: [skinrSlotId])
  skinrComponentCategoryId Int
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt()
  isDeleted                Boolean   @default(false)

  @@id([skinrSlotId, skinrComponentCategoryId])
}

/// A named set of slots offered to a group of hulls
/// (skinrSlotConfigurations.yaml).
model SkinrSlotConfiguration {
  skinrSlotConfigurationId Int                          @id
  name                     String
  priority                 Int?
  /// When true the configuration applies to every ship and `ships` is empty.
  allowAllShips            Boolean?
  slots                    SkinrSlotConfigurationSlot[]
  ships                    SkinrSlotConfigurationShip[]
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt()
  isDeleted                Boolean                      @default(false)
}

/// A slot included in a configuration (skinrSlotConfigurations.yaml `config[]`).
model SkinrSlotConfigurationSlot {
  skinrSlotConfigurationId Int
  configuration            SkinrSlotConfiguration @relation(fields: [skinrSlotConfigurationId], references: [skinrSlotConfigurationId])
  skinrSlotId              Int
  skinrSlot                SkinrSlot              @relation(fields: [skinrSlotId], references: [skinrSlotId])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt()
  isDeleted                Boolean                @default(false)

  @@id([skinrSlotConfigurationId, skinrSlotId])
  @@index([skinrSlotId])
}

/// A hull a configuration applies to (skinrSlotConfigurations.yaml `ships[]`).
model SkinrSlotConfigurationShip {
  skinrSlotConfigurationId Int
  configuration            SkinrSlotConfiguration @relation(fields: [skinrSlotConfigurationId], references: [skinrSlotConfigurationId])
  typeId                   Int
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt()
  isDeleted                Boolean                @default(false)

  @@id([skinrSlotConfigurationId, typeId])
}

/// Points needed to reach a SKIN tier, per ship-tree group
/// (skinrTierThresholds.yaml, a bare `tier -> points` map keyed by
/// shipTreeGroupID).
model SkinrTierThreshold {
  shipTreeGroupId Int
  shipTreeGroup   ShipTreeGroup @relation(fields: [shipTreeGroupId], references: [shipTreeGroupId])
  tier            Int
  points          Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt()
  isDeleted       Boolean       @default(false)

  @@id([shipTreeGroupId, tier])
}

// ---------------------------------------------------------------------------
// NPC corporation detail (npcCorporations.yaml)
//
// The file is 283 NPC corporations out of a Corporation table that also holds
// every player corporation, so ingestSdeNpcCorporations scopes its diff to ids
// that already exist — Corporation.memberCount and .name are required and the
// SDE does not supply memberCount, so it must never create a row.
// ---------------------------------------------------------------------------

/// A race allowed to join an NPC corporation (`allowedMemberRaces`).
model NpcCorporationAllowedRace {
  corporationId Int
  corporation   Corporation @relation(fields: [corporationId], references: [corporationId])
  raceId        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([corporationId, raceId])
}

/// An LP offer table an NPC corporation draws from (`lpOfferTables`).
model NpcCorporationLpOfferTable {
  corporationId  Int
  corporation    Corporation @relation(fields: [corporationId], references: [corporationId])
  lpOfferTableId Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt()
  isDeleted      Boolean     @default(false)

  @@id([corporationId, lpOfferTableId])
}

/// A division staffed at an NPC corporation (`divisions`), keyed by the
/// npcCorporationDivisions.yaml id.
model NpcCorporationDivisionSlot {
  corporationId            Int
  corporation              Corporation @relation(fields: [corporationId], references: [corporationId])
  npcCorporationDivisionId Int
  divisionNumber           Int?
  /// npcCharacters.yaml id of the division leader.
  leaderId                 Int?
  size                     Int?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt()
  isDeleted                Boolean     @default(false)

  @@id([corporationId, npcCorporationDivisionId])
}

/// Shares one NPC corporation holds in another (`investors`).
model NpcCorporationInvestor {
  corporationId         Int
  corporation           Corporation @relation("NpcCorporationInvestorCorp", fields: [corporationId], references: [corporationId])
  investorCorporationId Int
  investor              Corporation @relation("NpcCorporationInvestorHolder", fields: [investorCorporationId], references: [corporationId])
  shares                Int
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt()
  isDeleted             Boolean     @default(false)

  @@id([corporationId, investorCorporationId])
  @@index([investorCorporationId])
}

/// An NPC corporation's trade weighting for a type (`corporationTrades`).
model NpcCorporationTrade {
  corporationId Int
  corporation   Corporation @relation(fields: [corporationId], references: [corporationId])
  typeId        Int
  value         Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([corporationId, typeId])
}

/// An NPC corporation's exchange rate against another (`exchangeRates`).
model NpcCorporationExchangeRate {
  corporationId      Int
  corporation        Corporation @relation("NpcCorporationExchangeRateCorp", fields: [corporationId], references: [corporationId])
  otherCorporationId Int
  other              Corporation @relation("NpcCorporationExchangeRateOther", fields: [otherCorporationId], references: [corporationId])
  rate               Float
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt()
  isDeleted          Boolean     @default(false)

  @@id([corporationId, otherCorporationId])
  @@index([otherCorporationId])
}

// ---------------------------------------------------------------------------
// Remaining relational arrays (factions.yaml, mapSolarSystems.yaml)
// ---------------------------------------------------------------------------

/// A race that belongs to a faction (factions.yaml `memberRaces`).
model FactionMemberRace {
  factionId Int
  faction   Faction  @relation(fields: [factionId], references: [factionId])
  raceId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([factionId, raceId])
}

/// A category that may not be anchored in a system
/// (mapSolarSystems.yaml `disallowedAnchorCategories`).
model SolarSystemDisallowedAnchorCategory {
  solarSystemId Int
  solarSystem   SolarSystem @relation(fields: [solarSystemId], references: [solarSystemId])
  categoryId    Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([solarSystemId, categoryId])
}

/// A group that may not be anchored in a system
/// (mapSolarSystems.yaml `disallowedAnchorGroups`).
model SolarSystemDisallowedAnchorGroup {
  solarSystemId Int
  solarSystem   SolarSystem @relation(fields: [solarSystemId], references: [solarSystemId])
  groupId       Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([solarSystemId, groupId])
}

// ---------------------------------------------------------------------------
// SDE build 3475087 (2026-08-20) — the 23 files CCP added to the archive
//
// Ten of these were client-only data the CLI still reads from hoboleaks; the
// rest are new or newly-exported gameplay config. Two conventions hold across
// the whole section, both inherited from the earlier reference-table batch:
//
//   * Cross-FILE ids are plain `Int` columns with no Prisma relation — a type,
//     faction, group, category, dogma-attribute or type-list id is stored as a
//     number. That keeps the already-huge `Type` and `Faction` models from
//     growing a dozen more back-relations, and keeps each ingest independent of
//     the others' order. Relations exist only between models fed by the SAME
//     file.
//   * `{ dbuffCollectionId -> value }` maps get one child table per source file
//     rather than a single polymorphic table. The five sources are all keyed by
//     `typeId`, so a shared table could not be soft-deleted correctly: the
//     composite ingest scopes its diff by one field, and a job scoped on
//     `typeId` would treat another source's rows for the same type as deleted.
// ---------------------------------------------------------------------------

/// A wallet-journal reference type (accountingEntryTypes.yaml). `internalName`
/// is the string ESI returns as `ref_type` on the wallet-journal endpoints, so
/// it — not the numeric id — is the join key for ESI data. The two sets drift in
/// both directions, so treat a lookup miss as "show the raw string", never an
/// error.
model AccountingEntryType {
  accountingEntryTypeId Int      @id
  internalName          String
  /// The label the client shows for the entry type.
  name                  String
  /// Client-side template with `{name1}` / `{name2}` / `{arg}` placeholders.
  journalMessage        String?
  description           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt()
  isDeleted             Boolean  @default(false)

  @@index([internalName])
}

/// A character/corporation notification type (notificationTypes.yaml).
/// `internalName` is the string ESI returns in `type` on
/// `/characters/{id}/notifications/`; the numeric id only matches the client.
/// `displayName` is absent on exactly one record, and is not unique — several
/// types share a label — so never key anything on it.
model NotificationType {
  notificationTypeId Int      @id
  internalName       String
  displayName        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt()
  isDeleted          Boolean  @default(false)

  @@index([internalName])
}

/// A corporation role group (corporationRoleGroups.yaml) — the tab a role is
/// shown under in the corporation UI. `appliesTo` / `appliesToGrantable` name
/// the ESI member-roles fields the group's roles are read from.
model CorporationRoleGroup {
  corporationRoleGroupId Int      @id
  name                   String
  appliesTo              String
  appliesToGrantable     String
  isDivisional           Boolean
  isLocational           Boolean
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt()
  isDeleted              Boolean  @default(false)
}

/// A corporation role (corporationRoles.yaml). `shortName` is the internal
/// identifier (`roleDirector`, `roleAccountant`, …).
model CorporationRole {
  corporationRoleId Int                          @id
  shortName         String
  name              String
  description       String
  groupMemberships  CorporationRoleGroupMember[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt()
  isDeleted         Boolean                      @default(false)

  @@index([shortName])
}

/// Membership of a role in a role group (corporationRoles.yaml
/// `roleGroupIDs[]`). Only `corporationRoleGroupId` is cross-file, so it stays a
/// plain column; the role side comes from this very file and is a real relation.
model CorporationRoleGroupMember {
  corporationRoleId      Int
  role                   CorporationRole @relation(fields: [corporationRoleId], references: [corporationRoleId])
  corporationRoleGroupId Int
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt()
  isDeleted              Boolean         @default(false)

  @@id([corporationRoleId, corporationRoleGroupId])
  @@index([corporationRoleGroupId])
}

/// An Expert System (expertSystems.yaml) — a rentable package that grants a set
/// of skills at fixed levels for `durationDays`. Keyed by the item's own type
/// id, so this is a 1:1 extension of `Type`, not a new entity. `hidden` and
/// `retired` are independent flags and are the authoritative visibility signal;
/// `Type.published` disagrees with both. Only ~12 of the rows are live products,
/// the rest are QA fixtures and expired seasonal promotions.
model ExpertSystem {
  typeId       Int                 @id
  internalName String
  durationDays Int
  hidden       Boolean
  retired      Boolean
  skills       ExpertSystemSkill[]
  ships        ExpertSystemShip[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt()
  isDeleted    Boolean             @default(false)
}

/// A skill an Expert System grants, and at what level
/// (expertSystems.yaml `skillsGranted[]`).
model ExpertSystemSkill {
  typeId       Int
  expertSystem ExpertSystem @relation(fields: [typeId], references: [typeId])
  skillTypeId  Int
  level        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt()
  isDeleted    Boolean      @default(false)

  @@id([typeId, skillTypeId])
  @@index([skillTypeId])
}

/// A hull an Expert System advertises as unlocked
/// (expertSystems.yaml `associatedShipTypes[]`). Absent on the systems that
/// grant skills but no hulls, so an empty set is normal.
model ExpertSystemShip {
  typeId       Int
  expertSystem ExpertSystem @relation(fields: [typeId], references: [typeId])
  shipTypeId   Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt()
  isDeleted    Boolean      @default(false)

  @@id([typeId, shipTypeId])
  @@index([shipTypeId])
}

/// A fighter squadron ability (fighterAbilities.yaml) — the dictionary behind
/// the three ability buttons on a fighter squadron.
model FighterAbility {
  fighterAbilityId  Int      @id
  displayName       String
  tooltipText       String?
  /// `itemTargeted` | `pointTargeted` | `untargeted`.
  targetMode        String
  iconId            Int
  turretGraphicId   Int?
  disallowInHighSec Boolean
  disallowInLowSec  Boolean
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt()
  isDeleted         Boolean  @default(false)
}

/// One ability slot on one fighter hull (fighterAbilitiesByType.yaml). `slot` is
/// the index parsed from the `abilitySlotN` key: 0 is the always-available
/// attack, 1 the propulsion/utility ability (the only slot with a cooldown), 2
/// the limited-ammo heavy attack (the only slot with charges). Fighter hulls do
/// carry typeDogma — all 94 of them, with the per-ability damage, range and
/// duration numbers as `fighterAbility*` attributes — but the slot assignment,
/// the cooldown and the magazine live only here.
model TypeFighterAbility {
  typeId           Int
  slot             Int
  fighterAbilityId Int
  cooldownSeconds  Int?
  chargeCount      Int?
  rearmTimeSeconds Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()
  isDeleted        Boolean  @default(false)

  @@id([typeId, slot])
  @@index([fighterAbilityId])
}

/// An industry activity (industryActivities.yaml). The same six activities the
/// `BlueprintActivityType` enum names, as the numeric ids the rest of the
/// industry files reference. `name`/`description` are plain developer strings,
/// not localized.
model IndustryActivity {
  industryActivityId Int      @id
  name               String
  description        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt()
  isDeleted          Boolean  @default(false)
}

/// An industry assembly line (industryAssemblyLines.yaml) — one production slot
/// class, with the multipliers it applies. The `detailsPer*` children override
/// the base multipliers for a specific group, category or type list.
model IndustryAssemblyLine {
  industryAssemblyLineId Int                            @id
  name                   String
  description            String?
  industryActivityId     Int
  baseMaterialMultiplier Float
  baseTimeMultiplier     Float
  baseCostMultiplier     Float?
  groupDetails           IndustryAssemblyLineGroup[]
  categoryDetails        IndustryAssemblyLineCategory[]
  typeListDetails        IndustryAssemblyLineTypeList[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt()
  isDeleted              Boolean                        @default(false)

  @@index([industryActivityId])
}

/// Per-group multiplier override (industryAssemblyLines.yaml `detailsPerGroup[]`).
model IndustryAssemblyLineGroup {
  industryAssemblyLineId Int
  assemblyLine           IndustryAssemblyLine @relation(fields: [industryAssemblyLineId], references: [industryAssemblyLineId])
  groupId                Int
  materialMultiplier     Float
  timeMultiplier         Float
  costMultiplier         Float?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt()
  isDeleted              Boolean              @default(false)

  @@id([industryAssemblyLineId, groupId])
  @@index([groupId])
}

/// Per-category multiplier override
/// (industryAssemblyLines.yaml `detailsPerCategory[]`).
model IndustryAssemblyLineCategory {
  industryAssemblyLineId Int
  assemblyLine           IndustryAssemblyLine @relation(fields: [industryAssemblyLineId], references: [industryAssemblyLineId])
  categoryId             Int
  materialMultiplier     Float
  timeMultiplier         Float
  costMultiplier         Float?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt()
  isDeleted              Boolean              @default(false)

  @@id([industryAssemblyLineId, categoryId])
  @@index([categoryId])
}

/// Per-type-list multiplier override
/// (industryAssemblyLines.yaml `detailsPerTypeList[]`). `typeListId` points at
/// `TypeList`, which is ingested from typeLists.yaml.
model IndustryAssemblyLineTypeList {
  industryAssemblyLineId Int
  assemblyLine           IndustryAssemblyLine @relation(fields: [industryAssemblyLineId], references: [industryAssemblyLineId])
  typeListId             Int
  materialMultiplier     Float
  timeMultiplier         Float
  costMultiplier         Float?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt()
  isDeleted              Boolean              @default(false)

  @@id([industryAssemblyLineId, typeListId])
  @@index([typeListId])
}

/// An assembly line offered by an installation type
/// (industryInstallationTypes.yaml `assemblyLines[]`). The file carries nothing
/// but this pairing, so there is no separate installation header table — the set
/// of installation types is `SELECT DISTINCT typeId`.
model IndustryInstallationAssemblyLine {
  typeId                 Int
  industryAssemblyLineId Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt()
  isDeleted              Boolean  @default(false)

  @@id([typeId, industryAssemblyLineId])
  @@index([industryAssemblyLineId])
}

/// Which industry activity a modifier source applies to
/// (industryModifierSources.yaml). Values are the SDE's own keys verbatim, which
/// are camelCase here and snake_case in blueprints.yaml — hence a separate enum
/// from `BlueprintActivityType` rather than a shared one.
enum IndustryModifierActivity {
  copying
  invention
  manufacturing
  reaction
  researchMaterial
  researchTime
}

/// Which figure a modifier source moves (industryModifierSources.yaml).
enum IndustryModifierBucket {
  cost
  material
  time
}

/// A dogma attribute that modifies an industry job run in/with this type
/// (industryModifierSources.yaml) — the structure or rig bonus behind a job's
/// cost, material or time figure. `industryTargetFilterId` narrows the bonus to
/// a subset of blueprints, and **0 means no filter** (the SDE omits the key):
/// the sentinel keeps it inside the primary key, the way `TypeBonusLine` uses
/// `skillTypeId = 0` for role and misc bonuses. It belongs in the key because a
/// bucket is a list — 54 (type, activity, bucket) buckets already hold several
/// entries, up to 7 — and the filter is what tells two entries apart. Leaving it
/// out would let `ingestSdeCompositeTable` dedupe a future collision away
/// silently, since it drops duplicate keys last-wins before the diff.
model IndustryModifierSource {
  typeId                 Int
  activity               IndustryModifierActivity
  bucket                 IndustryModifierBucket
  dogmaAttributeId       Int
  industryTargetFilterId Int
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt()
  isDeleted              Boolean                  @default(false)

  @@id([typeId, activity, bucket, dogmaAttributeId, industryTargetFilterId])
  @@index([dogmaAttributeId])
}

/// A named set of groups/categories an industry bonus is restricted to
/// (industryTargetFilters.yaml). Distinct from `TypeList` — the two overlap on
/// one set by coincidence only.
model IndustryTargetFilter {
  industryTargetFilterId Int                            @id
  name                   String
  groups                 IndustryTargetFilterGroup[]
  categories             IndustryTargetFilterCategory[]
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt()
  isDeleted              Boolean                        @default(false)
}

/// A group included in an industry target filter
/// (industryTargetFilters.yaml `groupIDs[]`).
model IndustryTargetFilterGroup {
  industryTargetFilterId Int
  filter                 IndustryTargetFilter @relation(fields: [industryTargetFilterId], references: [industryTargetFilterId])
  groupId                Int
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt()
  isDeleted              Boolean              @default(false)

  @@id([industryTargetFilterId, groupId])
  @@index([groupId])
}

/// A category included in an industry target filter
/// (industryTargetFilters.yaml `categoryIDs[]`).
model IndustryTargetFilterCategory {
  industryTargetFilterId Int
  filter                 IndustryTargetFilter @relation(fields: [industryTargetFilterId], references: [industryTargetFilterId])
  categoryId             Int
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt()
  isDeleted              Boolean              @default(false)

  @@id([industryTargetFilterId, categoryId])
  @@index([categoryId])
}

/// Ship-linking config (linkWithShip.yaml) — currently the two CONCORD Rogue
/// Analysis Beacons and the Skyhook Reagent Silo. The row is the thing linked
/// TO; the ships allowed to link to it are the `TypeList` that
/// `linkableShipTypeListId` names.
model LinkWithShip {
  typeId                       Int                 @id
  applyPvpFlag                 Boolean
  canRelink                    Boolean
  characterEnergyCost          Float?
  dbuffPostLinkDuration        Int
  generateCynoInhibitor        Boolean
  keepDbuffDurationOnLinkBreak Boolean
  linkDuration                 Int
  linkEffectGraphicIdOverride  Int
  linkableShipTypeListId       Int
  maxLinkRange                 Int
  omegaOnly                    Boolean
  solarSystemInterferenceCost  Float?
  dbuffs                       LinkWithShipDbuff[]
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt()
  isDeleted                    Boolean             @default(false)
}

/// A dbuff the link applies (linkWithShip.yaml `dbuffs`).
model LinkWithShipDbuff {
  typeId            Int
  linkWithShip      LinkWithShip @relation(fields: [typeId], references: [typeId])
  dbuffCollectionId Int
  value             Float
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt()
  isDeleted         Boolean      @default(false)

  @@id([typeId, dbuffCollectionId])
  @@index([dbuffCollectionId])
}

/// Metenox Moon Drill mining config (metenoxMoonDrill.yaml). A single row.
model MetenoxMoonDrill {
  typeId                   Int      @id
  miningCycleTime          Int
  miningEfficiency         Float
  reagentsConsumedPerCycle Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt()
  isDeleted                Boolean  @default(false)
}

/// Proximity-trap config for a deployable (proximityTrap.yaml).
/// `triggerFilterTypeListId` points at `TypeList` — what sets the trap off.
model ProximityTrap {
  typeId                  Int                  @id
  dbuffDuration           Int
  forceDecloakDuration    Int?
  resetDelay              Int?
  showPerimeterLights     Boolean
  triggerDelay            Int
  triggerFilterTypeListId Int
  triggerRange            Int
  dbuffs                  ProximityTrapDbuff[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt()
  isDeleted               Boolean              @default(false)
}

/// A dbuff a proximity trap applies (proximityTrap.yaml `dbuffs`).
model ProximityTrapDbuff {
  typeId            Int
  proximityTrap     ProximityTrap @relation(fields: [typeId], references: [typeId])
  dbuffCollectionId Int
  value             Float
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt()
  isDeleted         Boolean       @default(false)

  @@id([typeId, dbuffCollectionId])
  @@index([dbuffCollectionId])
}

/// A proximity effect a deployed type projects onto everything in `radius`
/// after `delaySeconds` (appliedProximityEffects.yaml).
model AppliedProximityEffect {
  typeId       Int                           @id
  delaySeconds Int
  radius       Int
  dbuffs       AppliedProximityEffectDbuff[]
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt()
  isDeleted    Boolean                       @default(false)
}

/// A dbuff a proximity effect applies (appliedProximityEffects.yaml `dbuffs`).
model AppliedProximityEffectDbuff {
  typeId            Int
  effect            AppliedProximityEffect @relation(fields: [typeId], references: [typeId])
  dbuffCollectionId Int
  value             Float
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt()
  isDeleted         Boolean                @default(false)

  @@id([typeId, dbuffCollectionId])
  @@index([dbuffCollectionId])
}

/// Where a school's new capsuleers start (schoolMap.yaml). Keyed by the file's
/// own index rather than by school, which is how the SDE ships it; today 12 of
/// the 23 schools appear, each exactly once.
model SchoolMap {
  schoolMapId   Int      @id
  schoolId      Int
  solarSystemId Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt()
  isDeleted     Boolean  @default(false)

  @@index([schoolId])
}

/// A character-creation school (schools.yaml) — the academy a career path is
/// taken at, its owning NPC corporation and race.
model School {
  schoolId             Int                     @id
  name                 String
  title                String?
  description          String?
  characterDescription String?
  careerId             Int
  corporationId        Int
  raceId               Int
  iconId               Int?
  isStarterSpaceSchool Boolean?
  careerAgents         SchoolCareerAgent[]
  startingStations     SchoolStartingStation[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt()
  isDeleted            Boolean                 @default(false)
}

/// A career agent attached to a school (schools.yaml `careerAgents[]`).
/// `agentId` is an NPC character id.
model SchoolCareerAgent {
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [schoolId])
  agentId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([schoolId, agentId])
  @@index([agentId])
}

/// A station a school's graduates can start at
/// (schools.yaml `startingStations[]`).
model SchoolStartingStation {
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [schoolId])
  stationId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([schoolId, stationId])
  @@index([stationId])
}

/// A career skill plan (skillPlans.yaml) — the training queue the client
/// suggests for a career path. `description` is EVE-HTML and can carry
/// `fitting:` links.
model SkillPlan {
  skillPlanId              Int                  @id
  internalName             String
  name                     String
  description              String
  careerPathId             Int?
  factionId                Int?
  npcCorporationDivisionId Int?
  skills                   SkillPlanSkill[]
  milestones               SkillPlanMilestone[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt()
  isDeleted                Boolean              @default(false)
}

/// One step of a skill plan's training queue
/// (skillPlans.yaml `skillRequirements[]`). A plan trains the same skill several
/// times at rising levels, so the key is (plan, skill, level) — `sequence` keeps
/// the queue order without making the key shift when CCP inserts a step.
model SkillPlanSkill {
  skillPlanId Int
  skillPlan   SkillPlan @relation(fields: [skillPlanId], references: [skillPlanId])
  skillTypeId Int
  level       Int
  sequence    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  isDeleted   Boolean   @default(false)

  @@id([skillPlanId, skillTypeId, level])
  @@index([skillTypeId])
}

/// A milestone skill highlighted by a plan (skillPlans.yaml `milestones[]`).
/// `level` is absent on some milestones.
model SkillPlanMilestone {
  skillPlanId Int
  skillPlan   SkillPlan @relation(fields: [skillPlanId], references: [skillPlanId])
  typeId      Int
  level       Int?
  sequence    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  isDeleted   Boolean   @default(false)

  @@id([skillPlanId, typeId])
  @@index([typeId])
}

/// The default SKINR material for a slot, per faction
/// (skinrSlotsToMaterials.yaml — keyed by faction id, not by slot).
model SkinrFactionSlotMaterial {
  factionId      Int
  skinrSlotId    Int
  skinMaterialId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()
  isDeleted      Boolean  @default(false)

  @@id([factionId, skinrSlotId])
  @@index([skinrSlotId])
}

/// The standing a faction's stations demand before granting a service
/// (stationStandingsRestrictions.yaml). `stationServiceId` points at
/// `StationService`; a negative threshold denies the service to anyone below it.
model StationStandingsRestriction {
  factionId        Int
  stationServiceId Int
  minimumStanding  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()
  isDeleted        Boolean  @default(false)

  @@id([factionId, stationServiceId])
  @@index([stationServiceId])
}

/// A structure that periodically emits dbuffs across a system
/// (systemDbuffEmitters.yaml).
model SystemDbuffEmitter {
  typeId           Int                       @id
  duration         Int
  interval         Int
  excludeProtected Boolean
  dbuffs           SystemDbuffEmitterDbuff[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt()
  isDeleted        Boolean                   @default(false)
}

/// A dbuff a system emitter applies (systemDbuffEmitters.yaml `dbuffs`).
model SystemDbuffEmitterDbuff {
  typeId            Int
  emitter           SystemDbuffEmitter @relation(fields: [typeId], references: [typeId])
  dbuffCollectionId Int
  value             Float
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt()
  isDeleted         Boolean            @default(false)

  @@id([typeId, dbuffCollectionId])
  @@index([dbuffCollectionId])
}

/// A system-wide effect beacon (systemWideEffects.yaml) — wormhole and
/// Pochven-style environmental effects, keyed by the beacon's type id.
/// `eligibleTypeListId` points at `TypeList`: what the effect applies to.
model SystemWideEffect {
  typeId             Int                     @id
  eligibleTypeListId Int?
  environmentTypeId  Int?
  dbuffs             SystemWideEffectDbuff[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt()
  isDeleted          Boolean                 @default(false)
}

/// A dbuff a system-wide effect applies (systemWideEffects.yaml `dbuffs`).
model SystemWideEffectDbuff {
  typeId            Int
  effect            SystemWideEffect @relation(fields: [typeId], references: [typeId])
  dbuffCollectionId Int
  value             Float
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt()
  isDeleted         Boolean          @default(false)

  @@id([typeId, dbuffCollectionId])
  @@index([dbuffCollectionId])
}

/// A Space-Object-Factory scene layout applied to a hull graphic
/// (graphics.yaml `sofLayout[]`). A list, so it needs its own rows.
model GraphicSofLayout {
  graphicId Int
  graphic   Graphic  @relation(fields: [graphicId], references: [graphicId])
  layout    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([graphicId, layout])
}

/// A skill a new character of this race starts with (races.yaml `skills`, a bare
/// `skillTypeID -> level` map).
model RaceSkill {
  raceId      Int
  race        Race     @relation(fields: [raceId], references: [raceId])
  skillTypeId Int
  level       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
  isDeleted   Boolean  @default(false)

  @@id([raceId, skillTypeId])
  @@index([skillTypeId])
}

/// Which shape a Freelance job parameter takes (freelanceJobSchemas.yaml
/// `parameters.<key>.<kind>`). Values are the SDE's own keys verbatim.
enum FreelanceJobParameterKind {
  matcher
  boolean
  itemDelivery
}

/// One field a player must fill in when posting a Freelance job
/// (freelanceJobSchemas.yaml `parameters`). The three kinds share most columns;
/// the ones that do not apply to a kind stay null.
model FreelanceJobSchemaParameter {
  freelanceJobSchemaGroupId Int
  name                      String
  schema                    FreelanceJobSchema                     @relation(fields: [freelanceJobSchemaGroupId, name], references: [freelanceJobSchemaGroupId, name])
  paramKey                  String
  kind                      FreelanceJobParameterKind
  title                     String?
  description               String?
  unsetDescription          String?
  /// A string icon name here, not a numeric id — same as FreelanceJobSchema.iconId.
  iconId                    String?
  type                      String?
  maxEntries                Int?
  optional                  Boolean?
  choiceLabel               String?
  optionTrue                String?
  optionFalse               String?
  defaultValue              String?
  deliveryLocation          String?
  inventoryType             String?
  acceptedValueTypes        FreelanceJobSchemaParameterValueType[]
  createdAt                 DateTime                               @default(now())
  updatedAt                 DateTime                               @updatedAt()
  isDeleted                 Boolean                                @default(false)

  @@id([freelanceJobSchemaGroupId, name, paramKey])
  @@index([freelanceJobSchemaGroupId, name])
}

/// A value type a matcher parameter accepts
/// (freelanceJobSchemas.yaml `parameters.<key>.matcher.acceptedValueTypes[]`).
model FreelanceJobSchemaParameterValueType {
  freelanceJobSchemaGroupId Int
  name                      String
  paramKey                  String
  parameter                 FreelanceJobSchemaParameter @relation(fields: [freelanceJobSchemaGroupId, name, paramKey], references: [freelanceJobSchemaGroupId, name, paramKey])
  valueType                 String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt()
  isDeleted                 Boolean                     @default(false)

  @@id([freelanceJobSchemaGroupId, name, paramKey, valueType])
  @@index([freelanceJobSchemaGroupId, name, paramKey])
}

/// A skill an NPC character offers (npcCharacters.yaml `skills[]`). Hangs off
/// Character, not Agent: 174 of the 421 skill-bearing NPC characters are
/// corporation CEOs with no Agent row, and their skills are real data too. The
/// older `ResearchAgentSkills` covers only agentTypeID 4 (244 of them).
model NpcCharacterSkill {
  characterId Int
  character   Character @relation(fields: [characterId], references: [characterId])
  typeId      Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  isDeleted   Boolean   @default(false)

  @@id([characterId, typeId])
  @@index([typeId])
}
