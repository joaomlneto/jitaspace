model Killmail {
  /**
   * The unique ID of the killmail, which is also the killmail's kill ID.
   */
  killmailId    BigInt      @id
  /**
   * The hash of the killmail data
   */
  hash          String
  /**
   * Time at the which the victim was killed and the killmail was generated.
   */
  killmailTime  DateTime
  solarSystemId Int
  solarSystem   SolarSystem @relation("KillmailSolarSystem", fields: [solarSystemId], references: [solarSystemId])

  /**
   * The ID of the moon where the kill took place, if applicable.
   */
  moonId Int?
  /**
   * The moon where the kill took place, if applicable.
   */
  moon   Moon? @relation("KillmailMoon", fields: [moonId], references: [moonId])

  /**
   * Whether the metadata for this killmail has been fetched,
   * or if it is still pending.
   */
  metadataLoaded Boolean  @default(false)
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()
  isDeleted      Boolean  @default(false)

  warId Int?
  war   War? @relation("WarKillmails", fields: [warId], references: [warId])

  victim    KillmailVictim?    @relation("KillmailVictim")
  attackers KillmailAttacker[] @relation("KillmailAttackers")

  @@index([solarSystemId])
  @@index([moonId])
  @@index([warId])
}

model KillmailAttacker {
