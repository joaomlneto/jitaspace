   */
  createdAt                  DateTime                              @default(now())
  updatedAt                  DateTime                              @updatedAt()
  isDeleted                  Boolean                               @default(false)
  solarSystemFactions        Faction[]                             @relation("FactionSolarSystem")
  Planet                     Planet[]                              @relation("PlanetSolarSystem")
