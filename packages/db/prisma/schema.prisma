generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "cockroachdb"
}

enum CharacterGender {
  male
  female
}

model Character {
  characterId           Int                              @id
  birthday              DateTime
  bloodline             Bloodline                        @relation("CharacterBloodline", fields: [bloodlineId], references: [bloodlineId])
  bloodlineId           Int
  corporation           Corporation                      @relation("CharacterCorporation", fields: [corporationId], references: [corporationId])
  corporationId         Int
  description           String?
  faction               Faction?                         @relation("CharacterFaction", fields: [factionId], references: [factionId])
  factionId             Int?
  gender                CharacterGender
  name                  String
  race                  Race                             @relation("CharacterRace", fields: [raceId], references: [raceId])
  raceId                Int
  securityStatus        Float?
  title                 String?
  CorporationCeo        Corporation[]                    @relation("corporationCeo")
  createdCorporations   Corporation[]                    @relation("corporationCreator")
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  npcSkills             NpcCharacterSkill[]
  /// The third tier of race/bloodline/ancestry (npcCharacters.yaml `ancestryID`).
  ancestryId            Int?
  /// Whether the character name is globally unique (npcCharacters.yaml `uniqueName`).
  isUnique              Boolean?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt()
  isDeleted             Boolean                          @default(false)
  Agent                 Agent?                           @relation("AgentCharacter")
  researchAgents        ResearchAgent[]                  @relation("ResearchAgentCharacter")
  corporationMembership CharacterCorporationMembership[] @relation("CharacterCorporationMembershipEntry")
  Contract              Contract[]                       @relation("CharacterContractIssuer")
  killmailVictims       KillmailVictim[]                 @relation("KillmailVictimCharacter")
  killmailAttackers     KillmailAttacker[]               @relation("KillmailAttackerCharacter")

  @@index([bloodlineId])
  @@index([corporationId])
  @@index([factionId])
  @@index([raceId])
}

/**
 * A record of a character's membership in a corporation at a specific point in time.
 */
model CharacterCorporationMembership {
  /**
   * An ESI-provided incrementing ID that can be used to canonically establish order of records in cases where dates
   * may be ambiguous
   */
  recordId      Int         @id
  /**
   * The character that this record belongs to.
   */
  character     Character   @relation("CharacterCorporationMembershipEntry", fields: [characterId], references: [characterId])
  characterId   Int
  /**
   * The corporation that this record belongs to.
   */
  corporation   Corporation @relation("CorporationCharacterMembershipEntry", fields: [corporationId], references: [corporationId])
  corporationId Int
  /**
   * The datetime when the character joined the corporation.
   */
  startDate     DateTime
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt     DateTime    @default(now())
  /**
   * When this record was last updated.
   */
  updatedAt     DateTime    @updatedAt()

  @@index([characterId])
  @@index([corporationId])
}

model MarketGroup {
  marketGroupId       Int           @id
  name                String
  description         String
  types               Type[]
  parentMarketGroupId Int?
  parent              MarketGroup?  @relation("marketGroupParent", fields: [parentMarketGroupId], references: [marketGroupId], onDelete: Restrict, onUpdate: Restrict)
  children            MarketGroup[] @relation("marketGroupParent")
  // Only the SDE knows a market group's icon (ESI's market group endpoint does
  // not expose one), so this column is owned by ingestSdeMarketGroups.
  icon                Icon?         @relation(fields: [iconId], references: [iconId])
  iconId              Int?
  // SDE-only, owned by ingestSdeMarketGroups (ESI exposes no such flag).
  hasTypes            Boolean?
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt()
  isDeleted           Boolean       @default(false)

  @@index([parentMarketGroupId])
  @@index([iconId])
}

model Category {
  categoryId Int      @id
  groups     Group[]
  name       String
  published  Boolean
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  /// The category's icon (categories.yaml `iconID`).
  iconId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt()
  isDeleted  Boolean  @default(false)

  @@index([name])
}

model Group {
  groupId              Int                   @id
  category             Category              @relation(fields: [categoryId], references: [categoryId])
  categoryId           Int
  name                 String
  published            Boolean
  types                Type[]
  // SDE-only columns, owned by ingestSdeGroups.
  anchorable           Boolean?
  anchored             Boolean?
  fittableNonSingleton Boolean?
  useBasePrice         Boolean?
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  /// The group's icon (groups.yaml `iconID`).
  iconId               Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt()
  isDeleted            Boolean               @default(false)
  DogmaEffectModifier  DogmaEffectModifier[] @relation("DogmaEffectModifierGroup")

  @@index([categoryId])
}

model Type {
  typeId                          Int                             @id
  capacity                        Float?
  description                     String
  dogmaEffects                    DogmaEffect[]
  graphic                         Graphic?                        @relation(fields: [graphicId], references: [graphicId])
  graphicId                       Int?
  group                           Group                           @relation(fields: [groupId], references: [groupId])
  groupId                         Int
  icon                            Icon?                           @relation(fields: [iconId], references: [iconId])
  iconId                          Int?
  marketGroup                     MarketGroup?                    @relation(fields: [marketGroupId], references: [marketGroupId])
  marketGroupId                   Int?
  mass                            Float?
  name                            String
  packagedVolume                  Float?
  portionSize                     Int?
  published                       Boolean
  radius                          Float?
  stations                        Station[]
  volume                          Float?
  // SDE-only columns, owned by ingestSdeTypes — ESI's /universe/types/ does not
  // expose any of these, so the ESI type scraper excludes them from its diff.
  basePrice                       Float?
  metaLevel                       Int?
  techLevel                       Int?
  soundId                         Int?
  /// The base type a variant derives from (types.yaml `variationParentTypeID`) —
  /// e.g. a T2 or faction module points at its T1 hull. A plain id rather than a
  /// self-relation: the ingest writes every type in one chunked createMany, so a
  /// self-FK could reference a row not yet inserted.
  variationParentTypeId           Int?
  shipTreeGroup                   ShipTreeGroup?                  @relation(fields: [shipTreeGroupId], references: [shipTreeGroupId])
  shipTreeGroupId                 Int?
  // This Type's Dogma Attributes
  attributes                      TypeAttribute[]
  // This Type's Dogma Effects
  effects                         TypeEffect[]
  // Bloodlines that use this type as a Corvette
  bloodlines                      Bloodline[]                     @relation("BloodlineShipType")
  // Races that use this type as their starter ship
  races                           Race[]                          @relation("RaceShipType")
  // Planets that are of this type
  Planet                          Planet[]                        @relation("PlanetType")
  // Stars that are of this type
  Star                            Star[]                          @relation("StarType")
  // List of LP store offers where one can get this item
  loyaltyStoreOffers              LoyaltyStoreOffer[]
  // List of LP store offers that require this item
  loyaltyStoreOffersRequiredItems LoyaltyStoreOfferRequiredItem[] @relation("LoyaltyStoreOfferRequiredItem")
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt                       DateTime                        @default(now())
  // When was this record last updated
  updatedAt                       DateTime                        @updatedAt()
  // Was this item deleted
  /// The race a hull, skill or apparel item belongs to (types.yaml `raceID`).
  raceId                          Int?
  /// Tech I/II/III, Storyline, Faction, Officer, Deadspace, Abyssal …
  /// (types.yaml `metaGroupID`). A plain id: MetaGroup is ingested separately.
  metaGroupId                     Int?
  /// Whether an assembled item can be repackaged (types.yaml `isRepackable`).
  /// CCP only ever serializes this as true, never false.
  isRepackable                    Boolean?
  /// The faction a faction/pirate item belongs to (types.yaml `factionID`).
  /// FK-guarded on ingest: 59 of the 1,376 values name a faction the SDE's own
  /// factions.yaml does not contain, and those land null.
  factionId                       Int?
  isDeleted                       Boolean                         @default(false)
  Stargate                        Stargate[]                      @relation("StargateType")
  AgentInSpace                    AgentInSpace[]                  @relation("AgentInSpaceType")
  ResearchAgentSkills             ResearchAgentSkills[]           @relation("ResearchAgentSkillType")
  killmailAttackerShips           KillmailAttacker[]              @relation("KillmailAttackerShipType")
  killmailVictims                 KillmailVictim[]                @relation("KillmailVictimShipType")
  killmailAttackerWeapons         KillmailAttacker[]              @relation("KillmailAttackerWeaponType")
  killmailVictimItems             KillmailVictimItems[]           @relation("KillmailVictimItemType")
  blueprint                       Blueprint?                      @relation("BlueprintType")
  blueprintMaterials              BlueprintMaterial[]             @relation("BlueprintMaterials")
  blueprintProducts               BlueprintProduct[]              @relation("BlueprintProducts")
  blueprintSkills                 BlueprintSkill[]                @relation("BlueprintSkills")
  typeMaterials                   TypeMaterial[]                  @relation("TypeMaterialType")
  usedAsMaterialIn                TypeMaterial[]                  @relation("TypeMaterialMaterial")
  contrabandTypes                 ContrabandType[]
  certificateSkills               CertificateSkill[]
  certificateRecommendations      CertificateRecommendation[]
  masteries                       Mastery[]
  skinTypes                       SkinType[]

  @@index([marketGroupId])
  @@index([graphicId])
  @@index([groupId])
  @@index([iconId])
}

model TypeAttribute {
  type        Type           @relation(fields: [typeId], references: [typeId])
  attribute   DogmaAttribute @relation(fields: [attributeId], references: [attributeId])
  typeId      Int
  attributeId Int
  value       Float
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt()
  isDeleted   Boolean        @default(false)

  @@id([typeId, attributeId])
  @@index([typeId])
  @@index([attributeId])
}

model TypeEffect {
  type      Type        @relation(fields: [typeId], references: [typeId])
  typeId    Int
  effect    DogmaEffect @relation(fields: [effectId], references: [effectId])
  effectId  Int
  isDefault Boolean
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt()
  isDeleted Boolean     @default(false)

  @@id([typeId, effectId])
  @@index([typeId])
  @@index([effectId])
}

model Graphic {
  graphicId        Int                 @id
  collisionFile    String?
  graphicFile      String?
  iconFolder       String?
  sofDna           String?
  sofFactionName   String?
  sofHullName      String?
  sofRaceName      String?
  // SDE-only, owned by ingestSdeGraphics.
  sofMaterialSet   GraphicMaterialSet? @relation(fields: [sofMaterialSetId], references: [materialSetId])
  sofMaterialSetId Int?
  types            Type[]
  // Regions whose nebula scene is this graphic (mapRegions.yaml `nebulaID`).
  nebulaRegions    Region[]            @relation("RegionNebulaGraphic")
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  sofLayouts       GraphicSofLayout[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt()
  isDeleted        Boolean             @default(false)
}

model DogmaAttribute {
  attributeId                  Int                     @id
  defaultValue                 Float?
  description                  String?
  displayName                  String?
  highIsGood                   Boolean?
  iconId                       Int?
  name                         String?
  published                    Boolean?
  stackable                    Boolean?
  unitId                       Int?
  // SDE-only columns, owned by ingestSdeDogmaAttributes.
  dataType                     Int?
  displayWhenZero              Boolean?
  tooltipTitle                 String?
  tooltipDescription           String?
  // These three reference other DogmaAttribute rows. They are plain ids rather
  // than self-relations: the ingest writes all attributes in one chunked
  // createMany, so a self-FK could point at a row not yet inserted.
  maxAttributeId               Int?
  minAttributeId               Int?
  chargeRechargeTimeId         Int?
  // The attribute's grouping on the type page. SDE-only: ESI's dogma attribute
  // endpoint exposes no category.
  attributeCategory            DogmaAttributeCategory? @relation(fields: [attributeCategoryId], references: [attributeCategoryId])
  attributeCategoryId          Int?
  Icon                         Icon?                   @relation(fields: [iconId], references: [iconId])
  DogmaUnit                    DogmaUnit?              @relation(fields: [unitId], references: [unitId])
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt()
  isDeleted                    Boolean                 @default(false)
  TypeAttributes               TypeAttribute[]
  DischargeAttribute           DogmaEffect[]           @relation("DischargeAttribute")
  DurationAttribute            DogmaEffect[]           @relation("DurationAttribute")
  FalloffAttribute             DogmaEffect[]           @relation("FalloffAttribute")
  RangeAttribute               DogmaEffect[]           @relation("RangeAttribute")
  TrackingSpeedAttribute       DogmaEffect[]           @relation("TrackingSpeedAttribute")
  DogmaEffectsModified         DogmaEffectModifier[]   @relation("DogmaEffectsModified")
  DogmaEffectsModifying        DogmaEffectModifier[]   @relation("DogmaEffectsModifying")
  // Back-relations for the SDE-only attribute references on DogmaEffect.
  ResistanceAttribute          DogmaEffect[]           @relation("ResistanceAttribute")
  NpcActivationChanceAttribute DogmaEffect[]           @relation("NpcActivationChanceAttribute")
  FittingUsageChanceAttribute  DogmaEffect[]           @relation("FittingUsageChanceAttribute")
  NpcUsageChanceAttribute      DogmaEffect[]           @relation("NpcUsageChanceAttribute")

  @@index([unitId])
  @@index([iconId])
  @@index([attributeCategoryId])
}

model DogmaAttributeCategory {
  attributeCategoryId Int              @id
  name                String
  description         String?
  attributes          DogmaAttribute[]
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt()
  isDeleted           Boolean          @default(false)
}

model DogmaEffectCategory {
  effectCategoryId Int           @id
  name             String
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt()
  isDeleted        Boolean       @default(false)
  effects          DogmaEffect[]
}

model DogmaEffect {
  effectId                 Int                  @id
  description              String?
  disallowAutoRepeat       Boolean?
  dischargeAttribute       DogmaAttribute?      @relation("DischargeAttribute", fields: [dischargeAttributeId], references: [attributeId])
  dischargeAttributeId     Int?
  displayName              String?
  durationAttribute        DogmaAttribute?      @relation("DurationAttribute", fields: [durationAttributeId], references: [attributeId])
  durationAttributeId      Int?
  effectCategory           DogmaEffectCategory? @relation(fields: [effectCategoryId], references: [effectCategoryId])
  effectCategoryId         Int?
  electronicChance         Boolean?
  falloffAttribute         DogmaAttribute?      @relation("FalloffAttribute", fields: [falloffAttributeId], references: [attributeId])
  falloffAttributeId       Int?
  Icon                     Icon?                @relation(fields: [iconId], references: [iconId])
  iconId                   Int?
  isAssistance             Boolean?
  isOffensive              Boolean?
  isWarpSafe               Boolean?
  name                     String?
  postExpression           Int?
  preExpression            Int?
  published                Boolean?
  rangeAttribute           DogmaAttribute?      @relation("RangeAttribute", fields: [rangeAttributeId], references: [attributeId])
  rangeAttributeId         Int?
  rangeChance              Boolean?
  trackingSpeedAttribute   DogmaAttribute?      @relation("TrackingSpeedAttribute", fields: [trackingSpeedAttributeId], references: [attributeId])
  trackingSpeedAttributeId Int?

  // SDE-only columns, owned by ingestSdeDogmaEffects. DogmaAttribute is ingested
  // before DogmaEffect, so these are real foreign keys.
  propulsionChance               Boolean?
  guid                           String?
  distribution                   Int?
  resistanceAttribute            DogmaAttribute? @relation("ResistanceAttribute", fields: [resistanceAttributeId], references: [attributeId])
  resistanceAttributeId          Int?
  npcActivationChanceAttribute   DogmaAttribute? @relation("NpcActivationChanceAttribute", fields: [npcActivationChanceAttributeId], references: [attributeId])
  npcActivationChanceAttributeId Int?
  fittingUsageChanceAttribute    DogmaAttribute? @relation("FittingUsageChanceAttribute", fields: [fittingUsageChanceAttributeId], references: [attributeId])
  fittingUsageChanceAttributeId  Int?
  npcUsageChanceAttribute        DogmaAttribute? @relation("NpcUsageChanceAttribute", fields: [npcUsageChanceAttributeId], references: [attributeId])
  npcUsageChanceAttributeId      Int?

  types                Type[]
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt()
  isDeleted            Boolean               @default(false)
  DogmaEffectModifiers DogmaEffectModifier[] @relation("DogmaEffectModifiers")
  ModifiedDogmaEffect  DogmaEffectModifier[] @relation("ModifiedDogmaEffect")
  TypeEffect           TypeEffect[]

  @@index([dischargeAttributeId])
  @@index([durationAttributeId])
  @@index([effectCategoryId])
  @@index([falloffAttributeId])
  @@index([iconId])
  @@index([rangeAttributeId])
  @@index([trackingSpeedAttributeId])
  @@index([resistanceAttributeId])
  @@index([npcActivationChanceAttributeId])
  @@index([fittingUsageChanceAttributeId])
  @@index([npcUsageChanceAttributeId])
}

model DogmaEffectModifier {
  effect               DogmaEffect     @relation("DogmaEffectModifiers", fields: [effectId], references: [effectId])
  effectId             Int
  modifierIndex        Int
  domain               String?
  targetEffect         DogmaEffect?    @relation("ModifiedDogmaEffect", fields: [targetEffectId], references: [effectId])
  targetEffectId       Int?
  func                 String
  modifiedAttribute    DogmaAttribute? @relation("DogmaEffectsModified", fields: [modifiedAttributeId], references: [attributeId])
  modifiedAttributeId  Int?
  modifyingAttribute   DogmaAttribute? @relation("DogmaEffectsModifying", fields: [modifyingAttributeId], references: [attributeId])
  modifyingAttributeId Int?
  operator             Int?
  group                Group?          @relation("DogmaEffectModifierGroup", fields: [groupId], references: [groupId])
  groupId              Int?
  skillTypeId          Int?
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt()
  isDeleted            Boolean         @default(false)

  @@id([effectId, modifierIndex])
  @@index([effectId])
  @@index([targetEffectId])
  @@index([modifiedAttributeId])
  @@index([modifyingAttributeId])
}

model DogmaUnit {
  unitId      Int              @id
  name        String
  displayName String?
  description String?
  attributes  DogmaAttribute[]
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt()
  isDeleted   Boolean          @default(false)
}

model Icon {
  iconId       Int              @id
  description  String?
  iconFile     String
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt()
  isDeleted    Boolean          @default(false)
  attributes   DogmaAttribute[]
  types        Type[]
  effects      DogmaEffect[]
  ancestries   Ancestry[]       @relation("AncestryIcon")
  marketGroups MarketGroup[]
}

model Alliance {
  allianceId            Int          @id
  creatorCorporation    Corporation  @relation("AllianceCreator", fields: [creatorCorporationId], references: [corporationId])
  creatorCorporationId  Int
  dateFounded           DateTime
  executorCorporation   Corporation? @relation("AllianceExecutor", fields: [executorCorporationId], references: [corporationId])
  executorCorporationId Int?
  faction               Faction?     @relation(fields: [factionId], references: [factionId])
  factionId             Int?
  name                  String
  ticker                String
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt()
  isDeleted             Boolean      @default(false)

  memberCorporations Corporation[] @relation("CorporationAlliance")

  warsAggressor     War[]              @relation("WarAggressorAlliance")
  warsDefender      War[]              @relation("WarDefenderAlliance")
  warsAllies        AllianceWarAlly[]  @relation("AllianceWarAllies")
  killmailVictims   KillmailVictim[]   @relation("KillmailVictimAlliance")
  killmailAttackers KillmailAttacker[] @relation("KillmailAttackerAlliance")

  @@index([creatorCorporationId])
  @@index([factionId])
}

model Faction {
  factionId            Int                 @id
  name                 String
  description          String
  isUnique             Boolean
  militiaCorporation   Corporation?        @relation("FactionMilitiaCorporation", fields: [militiaCorporationId], references: [corporationId], onUpdate: NoAction, onDelete: NoAction)
  militiaCorporationId Int?
  alliances            Alliance[]
  corporations         Corporation[]       @relation("CorporationFaction")
  factionCorporation   Corporation?        @relation("FactionCorporation", fields: [corporationId], references: [corporationId], onUpdate: NoAction, onDelete: NoAction)
  corporationId        Int?
  sizeFactor           Float
  solarSystem          SolarSystem?        @relation("FactionSolarSystem", fields: [solarSystemId], references: [solarSystemId])
  solarSystemId        Int?
  // Systems held by this faction (inverse of SolarSystem.factionId).
  heldSolarSystems     SolarSystem[]       @relation("SolarSystemFaction")
  // do we need to store this?
  stationCount         Int
  // do we need to store this?
  stationSystemCount   Int
  // SDE-only columns, owned by ingestSdeFactions.
  flatLogo             String?
  flatLogoWithName     String?
  memberRaces          FactionMemberRace[]
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  /// The faction's icon (factions.yaml `iconID`), distinct from the flat logos.
  iconId               Int?
  /// One-line tagline, carried for the four empire factions only.
  shortDescription     String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt()
  isDeleted            Boolean             @default(false)
  Character            Character[]         @relation("CharacterFaction")
  races                Race[]              @relation("RaceFaction")
  killmailVictims      KillmailVictim[]    @relation("KillmailVictimFaction")
  killmailAttackers    KillmailAttacker[]  @relation("KillmailAttackerFaction")
  contrabandTypes      ContrabandType[]

  @@index([corporationId])
  @@index([militiaCorporationId])
  @@index([solarSystemId])
}

model Corporation {
  corporationId              Int                          @id
  alliance                   Alliance?                    @relation("CorporationAlliance", fields: [allianceId], references: [allianceId], onUpdate: NoAction, onDelete: NoAction)
  allianceId                 Int?
  // This cannot be null, but is a workaround for inserting mutually referencing entries
  ceo                        Character?                   @relation("corporationCeo", fields: [ceoId], references: [characterId], onUpdate: NoAction, onDelete: NoAction)
  ceoId                      Int?
  // This cannot be null, but is a workaround for inserting mutually referencing entries
  creator                    Character?                   @relation("corporationCreator", fields: [creatorId], references: [characterId], onUpdate: NoAction, onDelete: NoAction)
  creatorId                  Int?
  dateFounded                DateTime?
  description                String?
  // This cannot be null, but is a workaround for inserting mutually referencing entries
  faction                    Faction?                     @relation("CorporationFaction", fields: [factionId], references: [factionId])
  factionId                  Int?
  // This cannot be null, but is a workaround for inserting mutually referencing entries
  homeStation                Station?                     @relation("CorporationHomeStation", fields: [homeStationId], references: [stationId], onDelete: NoAction, onUpdate: NoAction)
  homeStationId              Int?
  memberCount                Int
  name                       String
  shares                     BigInt?
  taxRate                    Float
  ticker                     String
  url                        String?
  warEligible                Boolean?
  // SDE-only columns for NPC corporations, owned by ingestSdeNpcCorporations.
  // ceoID / taxRate / tickerName are deliberately NOT taken from the SDE — ESI
  // already owns ceoId / taxRate / ticker for every corporation, player or NPC.
  extent                     String?
  memberLimit                Int?
  minSecurity                Float?
  minimumJoinStanding        Float?
  initialPrice               Float?
  hasPlayerPersonnelManager  Boolean?
  sendCharTerminationMessage Boolean?
  mainActivityId             Int?
  secondaryActivityId        Int?
  enemyId                    Int?
  friendId                   Int?
  allowedRaces               NpcCorporationAllowedRace[]
  lpOfferTables              NpcCorporationLpOfferTable[]
  npcDivisions               NpcCorporationDivisionSlot[]
  investors                  NpcCorporationInvestor[]     @relation("NpcCorporationInvestorCorp")
  investedIn                 NpcCorporationInvestor[]     @relation("NpcCorporationInvestorHolder")
  trades                     NpcCorporationTrade[]
  exchangeRates              NpcCorporationExchangeRate[] @relation("NpcCorporationExchangeRateCorp")
  exchangeRatesTo            NpcCorporationExchangeRate[] @relation("NpcCorporationExchangeRateOther")
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  /// SDE-only columns from npcCorporations.yaml, owned by ingestSdeNpcCorporations.
  /// Size band (T/S/L/M/H) — distinct from the already-stored `extent`.
  size                       String?
  sizeFactor                 Float?
  /// Whether the corporation name is globally unique (npcCorporations.yaml `uniqueName`).
  isUnique                   Boolean?
  /// CCP's own deleted marker — NOT the ingest's `isDeleted` soft-delete flag.
  isDeletedByCcp             Boolean?
  solarSystemId              Int?
  raceId                     Int?
  iconId                     Int?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt()
  isDeleted                  Boolean                      @default(false)
  executorAlliance           Alliance[]                   @relation("AllianceExecutor")
  createdAlliances           Alliance[]                   @relation("AllianceCreator")
  ownedStations              Station[]                    @relation("StationOwner")
  bloodlines                 Bloodline[]                  @relation("BloodlineCorporation")
  CorporationFactions        Faction[]                    @relation("FactionCorporation")
  MilitiaFaction             Faction[]                    @relation("FactionMilitiaCorporation")
  Character                  Character[]                  @relation("CharacterCorporation")
  LoyaltyStoreOffer          LoyaltyStoreOffer[]          @relation("CorporationLoyaltyStoreOffers")

  warsAggressor       War[]                            @relation("WarAggressorCorporation")
  warsDefender        War[]                            @relation("WarDefenderCorporation")
  warsAllies          CorporationWarAlly[]             @relation("CorporationWarAllies")
  characterMembership CharacterCorporationMembership[] @relation("CorporationCharacterMembershipEntry")
  Contract            Contract[]                       @relation("CorporationContractIssuer")
  killmailVictims     KillmailVictim[]                 @relation("KillmailVictimCorporation")
  killmailAttackers   KillmailAttacker[]               @relation("KillmailAttackerCorporation")

  @@index([creatorId])
  @@index([factionId])
  @@index([homeStationId])
  @@index([allianceId])
  @@index([ceoId])
  @@index([name])
}

model Station {
  stationId                Int              @id
  name                     String
  solarSystem              SolarSystem?     @relation(fields: [solarSystemId], references: [solarSystemId])
  solarSystemId            Int?
  stationType              Type             @relation(fields: [typeId], references: [typeId])
  typeId                   Int
  // Nullable: not present in the SDE (ESI-only). SDE station ingestion leaves
  // these unset; the ESI scraper fills them.
  maxDockableShipVolume    Float?
  officeRentalCost         Float?
  owner                    Corporation?     @relation("StationOwner", fields: [ownerId], references: [corporationId])
  ownerId                  Int?
  // TODO add XYZ Position field
  // TODO add station services
  race                     Race?            @relation("RaceStations", fields: [raceId], references: [raceId])
  raceId                   Int?
  reprocessingEfficiency   Float
  reprocessingStationsTake Float
  // SDE-only, owned by ingestSdeStations. The inventory flag reprocessed output
  // lands in — currently 4 (Hangar) for every station, but CCP ships it per row.
  reprocessingHangarFlag   Int?
  /**
   * When this record was created in our database. Note that this is not provided by ESI and should not be used to determine the order of records.
   */
  /// The station's operation type (npcStations.yaml `operationID`) — already used to
  /// derive the station name, now stored so callers can resolve StationOperation.
  operationId              Int?
  /// The celestial the station orbits: a moon (3,986), a planet (1,223) or,
  /// once, a star — Zarzakh, which orbits no planet at all.
  orbitId                  Int?
  /// In-system coordinates (npcStations.yaml `position`).
  positionX                Float?
  positionY                Float?
  positionZ                Float?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt()
  isDeleted                Boolean          @default(false)
  stationServices          StationService[]
  corporationHomeStations  Corporation[]    @relation("CorporationHomeStation")
  Agent                    Agent[]          @relation("AgentStation")

  CourierContractStartLocation CourierContract[] @relation("CourierContractStartLocation")
  CourierContractEndLocation   CourierContract[] @relation("CourierContractEndLocation")

  @@index([solarSystemId])
  @@index([typeId])
  @@index([ownerId])
  @@index([raceId])
}

