  character   Character?   @relation("KillmailAttackerCharacter", fields: [characterId], references: [characterId])
  faction     Faction?     @relation("KillmailAttackerFaction", fields: [factionId], references: [factionId])

  @@id([killmailId, attackerIndex])
  @@index([killmailId])
  @@index([characterId])
  @@index([corporationId])
  @@index([allianceId])
  @@index([factionId])
