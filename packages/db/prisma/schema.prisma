  copying
  invention
  manufacturing
  reaction
  research_material
  research_time
}

model Blueprint {
  blueprintTypeId    Int                 @id
  blueprintType      Type                @relation("BlueprintType", fields: [blueprintTypeId], references: [typeId])
  maxProductionLimit Int
  activities         BlueprintActivity[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt()
  isDeleted          Boolean             @default(false)
}

model BlueprintActivity {
  blueprintTypeId Int
  blueprint       Blueprint             @relation(fields: [blueprintTypeId], references: [blueprintTypeId])
  activity        BlueprintActivityType
  time            Int
  materials       BlueprintMaterial[]
  products        BlueprintProduct[]
  skills          BlueprintSkill[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt()
  isDeleted       Boolean               @default(false)

  @@id([blueprintTypeId, activity])
}

model BlueprintMaterial {
  blueprintTypeId   Int
  activity          BlueprintActivityType
  blueprintActivity BlueprintActivity     @relation(fields: [blueprintTypeId, activity], references: [blueprintTypeId, activity])
  materialTypeId    Int
  materialType      Type                  @relation("BlueprintMaterials", fields: [materialTypeId], references: [typeId])
  quantity          Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt()
  isDeleted         Boolean               @default(false)

  @@id([blueprintTypeId, activity, materialTypeId])
  @@index([materialTypeId])
}

model BlueprintProduct {
  blueprintTypeId   Int
  activity          BlueprintActivityType
  blueprintActivity BlueprintActivity     @relation(fields: [blueprintTypeId, activity], references: [blueprintTypeId, activity])
  productTypeId     Int
  productType       Type                  @relation("BlueprintProducts", fields: [productTypeId], references: [typeId])
  quantity          Int
  // Probability of a successful invention run; only set for `invention` products.
  probability       Float?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt()
  isDeleted         Boolean               @default(false)

  @@id([blueprintTypeId, activity, productTypeId])
  @@index([productTypeId])
}

model BlueprintSkill {
  blueprintTypeId   Int
  activity          BlueprintActivityType
  blueprintActivity BlueprintActivity     @relation(fields: [blueprintTypeId, activity], references: [blueprintTypeId, activity])
  skillTypeId       Int
  skillType         Type                  @relation("BlueprintSkills", fields: [skillTypeId], references: [typeId])
  level             Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt()
  isDeleted         Boolean               @default(false)

  @@id([blueprintTypeId, activity, skillTypeId])
  @@index([skillTypeId])
}

// ---------------------------------------------------------------------------
// SDE tables ingested directly from the Static Data Export (no ESI equivalent)
// ---------------------------------------------------------------------------

/// Tech level / faction grouping for items (metaGroups.yaml).
model MetaGroup {
  metaGroupId Int      @id
  name        String
  description String?
  iconId      Int?
  iconSuffix  String?
  // RGB tint (0..1 floats) used to colour the meta-group badge; absent for some groups.
  colorR      Float?
  colorG      Float?
  colorB      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
  isDeleted   Boolean  @default(false)
}

/// Reprocessing / refining output of a type (typeMaterials.yaml `materials`).
model TypeMaterial {
  typeId         Int
  type           Type     @relation("TypeMaterialType", fields: [typeId], references: [typeId])
  materialTypeId Int
  materialType   Type     @relation("TypeMaterialMaterial", fields: [materialTypeId], references: [typeId])
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()
  isDeleted      Boolean  @default(false)

  @@id([typeId, materialTypeId])
  @@index([typeId])
  @@index([materialTypeId])
}

/// Per-faction contraband rules for a type (contrabandTypes.yaml).
model ContrabandType {
  typeId           Int
  type             Type     @relation(fields: [typeId], references: [typeId])
  factionId        Int
  faction          Faction  @relation(fields: [factionId], references: [factionId])
  attackMinSec     Float
  confiscateMinSec Float
  fineByValue      Float
  standingLoss     Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()
  isDeleted        Boolean  @default(false)

  @@id([typeId, factionId])
  @@index([typeId])
  @@index([factionId])
}

/// A mastery/competency certificate (certificates.yaml).
model Certificate {
  certificateId   Int                         @id
  name            String
  description     String
  groupId         Int
  skills          CertificateSkill[]
  recommendations CertificateRecommendation[]
  masteries       Mastery[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt()
  isDeleted       Boolean                     @default(false)

  @@index([groupId])
}

/// Required skill levels at each certificate grade (certificates.yaml `skillTypes`).
model CertificateSkill {
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [certificateId])
  skillTypeId   Int
  skillType     Type        @relation(fields: [skillTypeId], references: [typeId])
  basic         Int
  standard      Int
  improved      Int
  advanced      Int
  elite         Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([certificateId, skillTypeId])
  @@index([certificateId])
  @@index([skillTypeId])
}

/// Types a certificate is recommended for (certificates.yaml `recommendedFor`).
model CertificateRecommendation {
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [certificateId])
  typeId        Int
  type          Type        @relation(fields: [typeId], references: [typeId])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([certificateId, typeId])
  @@index([certificateId])
  @@index([typeId])
}

/// Certificates earned by a type at each mastery level 0..4 (masteries.yaml).
model Mastery {
  typeId        Int
  type          Type        @relation(fields: [typeId], references: [typeId])
  masteryLevel  Int
  certificateId Int
  certificate   Certificate @relation(fields: [certificateId], references: [certificateId])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  isDeleted     Boolean     @default(false)

  @@id([typeId, masteryLevel, certificateId])
  @@index([typeId])
  @@index([certificateId])
}

/// A SKIN material / colour set (skinMaterials.yaml).
model SkinMaterial {
  skinMaterialId Int      @id
  displayName    String?
  /// Points at GraphicMaterialSet.materialSetId, but deliberately NOT a declared
  /// relation: the column is required, so a dangling upstream reference would
  /// fail the whole skinMaterials ingest — and skipping the row would then break
  /// Skin.skinMaterialId, which foreign-keys it.
  materialSetId  Int
  skins          Skin[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()
  isDeleted      Boolean  @default(false)

  @@index([materialSetId])
}

/// A ship/structure SKIN (skins.yaml).
model Skin {
  skinId             Int           @id
  skinMaterialId     Int
  skinMaterial       SkinMaterial  @relation(fields: [skinMaterialId], references: [skinMaterialId])
  internalName       String
  allowCcpDevs       Boolean
  isStructureSkin    Boolean?
  visibleSerenity    Boolean
  visibleTranquility Boolean
  types              SkinType[]
  licenses           SkinLicense[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt()
  isDeleted          Boolean       @default(false)

  @@index([skinMaterialId])
}

/// Types a SKIN can be applied to (skins.yaml `types`).
model SkinType {
  skinId    Int
  skin      Skin     @relation(fields: [skinId], references: [skinId])
  typeId    Int
  type      Type     @relation(fields: [typeId], references: [typeId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([skinId, typeId])
  @@index([skinId])
  @@index([typeId])
}

/// A SKIN license item that grants a SKIN (skinLicenses.yaml).
model SkinLicense {
  licenseTypeId Int      @id
  skinId        Int
  skin          Skin     @relation(fields: [skinId], references: [skinId])
  duration      Int
  isSingleUse   Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt()
  isDeleted     Boolean  @default(false)

  @@index([skinId])
}

/// What a TypeListEntry points at (type / group / category).
enum TypeListRefType {
  type
  group
  category
}

/// A named set of types defined by include/exclude rules (typeLists.yaml).
model TypeList {
  typeListId         Int             @id
  name               String
  displayName        String?
  displayDescription String?
  entries            TypeListEntry[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt()
  isDeleted          Boolean         @default(false)
}

/// One include/exclude membership rule of a TypeList. `refId` is polymorphic
/// (a type, group, or category id per `refType`), so it has no foreign key.
model TypeListEntry {
  typeListId Int
  typeList   TypeList        @relation(fields: [typeListId], references: [typeListId])
  included   Boolean
  refType    TypeListRefType
  refId      Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt()
  isDeleted  Boolean         @default(false)

  @@id([typeListId, included, refType, refId])
  @@index([typeListId])
}

/// An NPC corporation activity category (corporationActivities.yaml).
model CorporationActivity {
  corporationActivityId Int      @id
  name                  String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt()
  isDeleted             Boolean  @default(false)
}

/// A Mercenary Den tactical operation (mercenaryTacticalOperations.yaml).
model MercenaryTacticalOperation {
  mercenaryTacticalOperationId Int      @id
  name                         String
  description                  String
  // The dungeon this operation runs in. dungeons.yaml is not ingested, so this
  // is a plain id with no foreign key.
  dungeonId                    Int
  anarchyImpact                Int
  developmentImpact            Int
  infomorphBonus               Int
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt()
  isDeleted                    Boolean  @default(false)
}

/// A freelance job schema (freelanceJobSchemas.yaml). Only the descriptive
/// fields and content tags are modelled; the deep `parameters` / contribution
/// tuning config is not.
model FreelanceJobSchema {
  freelanceJobSchemaGroupId Int
  name                      String
  title                     String?
  description               String?
  iconId                    String?
  progressDescription       String?
  rewardDescription         String?
  targetDescription         String?
  tags                      FreelanceJobSchemaTag[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt()
  isDeleted                 Boolean                 @default(false)

  @@id([freelanceJobSchemaGroupId, name])
}

/// One content tag of a freelance job schema (freelanceJobSchemas.yaml `contentTags`).
model FreelanceJobSchemaTag {
  freelanceJobSchemaGroupId Int
  name                      String
  schema                    FreelanceJobSchema @relation(fields: [freelanceJobSchemaGroupId, name], references: [freelanceJobSchemaGroupId, name])
  tag                       String
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt()
  isDeleted                 Boolean            @default(false)

  @@id([freelanceJobSchemaGroupId, name, tag])
  @@index([freelanceJobSchemaGroupId, name])
}

// ---------------------------------------------------------------------------
// Further SDE reference tables. Cross-entity references (types, attributes,
// factions, groups, skills) are stored as plain integer ids without foreign
// keys, to keep these niche tables from adding back-relations to the `Type`
// model. They are normalized internally (composite keys / child tables).
// ---------------------------------------------------------------------------

/// Maps a type to its compressed equivalent (compressibleTypes.yaml).
model CompressibleType {
  typeId           Int      @id
  compressedTypeId Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()
  isDeleted        Boolean  @default(false)

  @@index([compressedTypeId])
}

/// The 5 character attributes used in skill training (characterAttributes.yaml).
model CharacterAttribute {
  attributeId      Int      @id
  name             String
  description      String
  shortDescription String
  notes            String
  iconId           Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()
  isDeleted        Boolean  @default(false)
}

/// A short identifier title a character can display (characterTitles.yaml).
/// Keyed by a UUID string.
model CharacterTitle {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)
}

/// A client translation language (translationLanguages.yaml). Keyed by code.
model TranslationLanguage {
  languageId String   @id
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt()
  isDeleted  Boolean  @default(false)
}

/// A site archetype, grouping dungeons by theme (archetypes.yaml).
model Archetype {
  archetypeId Int      @id
  title       String?
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
  isDeleted   Boolean  @default(false)
}

/// A named landmark in space (landmarks.yaml).
model Landmark {
  landmarkId  Int      @id
  name        String
  description String?
  iconId      Int?
  // The solar system the landmark is located in, when applicable.
  locationId  Int?
  positionX   Float
  positionY   Float
  positionZ   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt()
  isDeleted   Boolean  @default(false)
}

/// A secondary sun of a (binary) solar system (mapSecondarySuns.yaml).
model MapSecondarySun {
  secondarySunId     Int      @id
  solarSystemId      Int
  typeId             Int
  effectBeaconTypeId Int
  positionX          Float
  positionY          Float
  positionZ          Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt()
  isDeleted          Boolean  @default(false)

  @@index([solarSystemId])
}

/// A sovereignty hub upgrade (sovereigntyUpgrades.yaml).
model SovereigntyUpgrade {
  typeId                 Int      @id
  mutuallyExclusiveGroup String
  fuelTypeId             Int?
  fuelHourlyUpkeep       Int?
  fuelStartupCost        Int?
  powerAllocation        Int?
  powerProduction        Int?
  workforceAllocation    Int?
  workforceProduction    Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt()
  isDeleted              Boolean  @default(false)
}

/// Sparse planetary colony resource of a planet (planetResources.yaml). Each
/// planet provides exactly one of power / workforce / a reagent.
model PlanetResource {
  planetId                 Int      @id
  power                    Int?
  workforce                Int?
  reagentTypeId            Int?
  reagentAmountPerCycle    Int?
  reagentCyclePeriod       Int?
  reagentSecuredCapacity   Int?
  reagentUnsecuredCapacity Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt()
  isDeleted                Boolean  @default(false)
}

/// What a TypeBonusLine applies to.
enum TypeBonusKind {
  role
  skill
  misc
}

/// Per-type trait/bonus header (typeBonus.yaml).
model TypeBonus {
  typeId    Int             @id
  iconId    Int?
  lines     TypeBonusLine[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt()
  isDeleted Boolean         @default(false)
}

/// One trait/bonus line of a type (typeBonus.yaml role/skill/misc bonuses).
/// `skillTypeId` is 0 for role and misc bonuses; `sequence` preserves order.
model TypeBonusLine {
  typeId      Int
  typeBonus   TypeBonus     @relation(fields: [typeId], references: [typeId])
  kind        TypeBonusKind
  skillTypeId Int
  sequence    Int
  bonus       Float?
  bonusText   String?
  importance  Int?
  unitId      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt()
  isDeleted   Boolean       @default(false)

  @@id([typeId, kind, skillTypeId, sequence])
  @@index([typeId])
}

/// A control tower (POS) fuel/resource requirement line (controlTowerResources.yaml).
/// `sequence` preserves order (a resourceTypeId can repeat across factions).
model ControlTowerResource {
  controlTowerTypeId Int
  sequence           Int
  purpose            Int
  quantity           Int
  resourceTypeId     Int
  factionId          Int?
  minSecurityLevel   Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt()
  isDeleted          Boolean  @default(false)

  @@id([controlTowerTypeId, sequence])
}

/// A mutaplasmid (dynamicItemAttributes.yaml) — the entity set; ranges and
/// type mappings live in the child tables.
model DynamicItemAttribute {
  mutaplasmidTypeId Int                           @id
  ranges            DynamicItemAttributeRange[]
  mappings          DynamicItemAttributeMapping[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt()
  isDeleted         Boolean                       @default(false)
}

/// The min/max range a mutaplasmid rolls for a dogma attribute.
model DynamicItemAttributeRange {
  mutaplasmidTypeId Int
  mutaplasmid       DynamicItemAttribute @relation(fields: [mutaplasmidTypeId], references: [mutaplasmidTypeId])
  attributeId       Int
  min               Float
  max               Float
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt()
  isDeleted         Boolean              @default(false)

  @@id([mutaplasmidTypeId, attributeId])
}

/// Which base type a mutaplasmid applies to and what it produces.
model DynamicItemAttributeMapping {
  mutaplasmidTypeId Int
  mutaplasmid       DynamicItemAttribute @relation(fields: [mutaplasmidTypeId], references: [mutaplasmidTypeId])
  resultingTypeId   Int
  applicableTypeId  Int
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt()
  isDeleted         Boolean              @default(false)

  @@id([mutaplasmidTypeId, resultingTypeId, applicableTypeId])
}

/// What a DbuffModifier targets.
enum DbuffModifierKind {
  item
  location
  locationGroup
  locationRequiredSkill
}

/// A dynamic buff collection (dbuffCollections.yaml).
model DbuffCollection {
  dbuffCollectionId    Int             @id
  aggregateMode        String
  developerDescription String
  displayName          String?
  operationName        String
  showOutputValueInUI  String
  modifiers            DbuffModifier[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt()
  isDeleted            Boolean         @default(false)
}

/// One modifier of a dbuff collection. `groupId`/`skillId` are set only for the
/// locationGroup / locationRequiredSkill kinds; `sequence` preserves order.
model DbuffModifier {
  dbuffCollectionId Int
  dbuffCollection   DbuffCollection   @relation(fields: [dbuffCollectionId], references: [dbuffCollectionId])
  kind              DbuffModifierKind
  sequence          Int
  dogmaAttributeId  Int
  groupId           Int?
  skillId           Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt()
  isDeleted         Boolean           @default(false)

  @@id([dbuffCollectionId, kind, sequence])
}

/// A planetary-industry production schematic (planetSchematics.yaml).
model PlanetSchematic {
  planetSchematicId Int                   @id
  name              String
  cycleTime         Int
  types             PlanetSchematicType[]
  pins              PlanetSchematicPin[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt()
  isDeleted         Boolean               @default(false)
}

/// An input/output material of a planetary schematic.
model PlanetSchematicType {
  planetSchematicId Int
  planetSchematic   PlanetSchematic @relation(fields: [planetSchematicId], references: [planetSchematicId])
  typeId            Int
  isInput           Boolean
  quantity          Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt()
  isDeleted         Boolean         @default(false)

  @@id([planetSchematicId, typeId])
}

/// A pin (structure) type usable for a planetary schematic.
model PlanetSchematicPin {
  planetSchematicId Int
  planetSchematic   PlanetSchematic @relation(fields: [planetSchematicId], references: [planetSchematicId])
  pinTypeId         Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt()
  isDeleted         Boolean         @default(false)

  @@id([planetSchematicId, pinTypeId])
}

/// A dungeon / encounter site definition (dungeons.yaml).
model Dungeon {
  dungeonId           Int                  @id
  name                String
  description         String?
  gameplayDescription String?
  archetypeId         Int
  factionId           Int?
  allowedShips        DungeonAllowedShip[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt()
  isDeleted           Boolean              @default(false)

  @@index([archetypeId])
}

/// A ship type allowed to enter a dungeon (dungeons.yaml `allowedShipsList`).
model DungeonAllowedShip {
  dungeonId  Int
  dungeon    Dungeon  @relation(fields: [dungeonId], references: [dungeonId])
  shipTypeId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt()
  isDeleted  Boolean  @default(false)

  @@id([dungeonId, shipTypeId])
}

/// An Alpha-clone skill grade (cloneGrades.yaml).
model CloneGrade {
  cloneGradeId Int               @id
  name         String
  skills       CloneGradeSkill[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt()
  isDeleted    Boolean           @default(false)
}

/// The level cap a clone grade grants for a skill (cloneGrades.yaml `skills`).
model CloneGradeSkill {
  cloneGradeId Int
  cloneGrade   CloneGrade @relation(fields: [cloneGradeId], references: [cloneGradeId])
  skillTypeId  Int
  level        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt()
  isDeleted    Boolean    @default(false)

  @@id([cloneGradeId, skillTypeId])
}

/// A station operation type (stationOperations.yaml). The `operationName` is also
/// used (by the stations ingest) to build `Station.name`; this captures the full
/// operation definition. Cross-entity ids are plain integers (no foreign keys).
model StationOperation {
  stationOperationId  Int                           @id
  activityId          Int
  operationName       String
  description         String?
  border              Float
  corridor            Float
  fringe              Float
  hub                 Float
  ratio               Float
  manufacturingFactor Float
  researchFactor      Float
  services            StationOperationService[]
  stationTypes        StationOperationStationType[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt()
  isDeleted           Boolean                       @default(false)
}

/// A service offered by a station operation (stationOperations.yaml `services`).
model StationOperationService {
  stationOperationId Int
  stationOperation   StationOperation @relation(fields: [stationOperationId], references: [stationOperationId])
  serviceId          Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt()
  isDeleted          Boolean          @default(false)

  @@id([stationOperationId, serviceId])
}

/// The station type used per race for a station operation
/// (stationOperations.yaml `stationTypes`).
model StationOperationStationType {
  stationOperationId Int
  stationOperation   StationOperation @relation(fields: [stationOperationId], references: [stationOperationId])
  raceId             Int
  stationTypeId      Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt()
  isDeleted          Boolean          @default(false)

  @@id([stationOperationId, raceId])
}

// ---------------------------------------------------------------------------
// Agent missions and epic arcs (missions.yaml, epicArcs.yaml)
//
// Cross-entity ids here are plain Int columns rather than relations, matching
// StationOperationService.serviceId / StationOperationStationType.stationTypeId:
// these SDE tables reference a wide spread of entities, and a relation per id
// would need a back-relation on every referenced model.
// ---------------------------------------------------------------------------

/// An agent mission (missions.yaml). The single-object `killMission`,
/// `courierMission` and `missionRewards` sub-objects are flattened into
/// prefixed columns, as MetaGroup does for `color`.
model Mission {
  missionId                            Int                    @id
  name                                 String
  /// factions.yaml id of the mission's faction.
  factionId                            Int?
  /// npcCorporations.yaml id of the offering corporation.
  corporationId                        Int?
  /// agentTypes.yaml id.
  agentTypeId                          Int?
  expirationTime                       Int?
  hasStandingRewards                   Boolean?
  /// types.yaml id of the gift handed over when the mission is offered.
  initialAgentGiftTypeId               Int?
  initialAgentGiftQuantity             Int?
  // killMission.*
  killDungeonId                        Int?
  killObjectiveTypeId                  Int?
  killObjectiveQuantity                Int?
  /// Despite the name, `killMission.dropItemInMissionContainer` is a types.yaml
  /// id (the item dropped in the mission container), never a boolean.
  killDropItemInMissionContainerTypeId Int?
  // courierMission.*
  courierObjectiveTypeId               Int?
  courierObjectiveQuantity             Int?
  courierObjectiveSingleton            Boolean?
  // missionRewards.*
  rewardTypeId                         Int?
  rewardQuantity                       Int?
  bonusRewardTypeId                    Int?
  bonusRewardQuantity                  Int?
  bonusTimeInterval                    Int?
  messages                             MissionMessage[]
  extraStandings                       MissionExtraStanding[]
  epicArcMissions                      EpicArcMission[]
  createdAt                            DateTime               @default(now())
  updatedAt                            DateTime               @updatedAt()
  isDeleted                            Boolean                @default(false)

  @@index([factionId])
  @@index([corporationId])
}

/// One localized message slot on a mission (missions.yaml `messages`), keyed by
/// its dotted message id (e.g. `messages.mission.briefing`). English text only,
/// like every other localized column in this schema.
model MissionMessage {
  missionId Int
  mission   Mission  @relation(fields: [missionId], references: [missionId])
  key       String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([missionId, key])
}

/// Extra standing gained with a third-party faction (missions.yaml
/// `extraStandings`), keyed by that faction's id.
model MissionExtraStanding {
  missionId Int
  mission   Mission  @relation(fields: [missionId], references: [missionId])
  factionId Int
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  isDeleted Boolean  @default(false)

  @@id([missionId, factionId])
}

/// An epic arc — a branching chain of missions (epicArcs.yaml).
model EpicArc {
  epicArcId          Int              @id
  name               String
  /// factions.yaml id.
  factionId          Int?
  /// icons.yaml id.
  iconId             Int?
  arcRestartInterval Int?
  missions           EpicArcMission[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt()
  isDeleted          Boolean          @default(false)

  @@index([factionId])
}

/// A mission's node in an epic arc (epicArcs.yaml `missions`).
model EpicArcMission {
  epicArcId     Int
  epicArc       EpicArc              @relation(fields: [epicArcId], references: [epicArcId])
  missionId     Int
  mission       Mission              @relation(fields: [missionId], references: [missionId])
  /// npcCharacters.yaml id of the agent offering this step.
  agentId       Int?
  failMissionId Int?
  nextMissions  EpicArcMissionNext[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt()
  isDeleted     Boolean              @default(false)

  @@id([epicArcId, missionId])
  @@index([missionId])
}

/// An outgoing edge in the epic-arc mission graph
/// (epicArcs.yaml `missions.*.nextMissions`).
model EpicArcMissionNext {
  epicArcId      Int
  missionId      Int
  epicArcMission EpicArcMission @relation(fields: [epicArcId, missionId], references: [epicArcId, missionId])
  nextMissionId  Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt()
  isDeleted      Boolean        @default(false)

  @@id([epicArcId, missionId, nextMissionId])
}

// ---------------------------------------------------------------------------
// Ship tree (shipTreeElements/Factions/Groups.yaml, typeElements.yaml)
//
// The "elements" maps are `slot -> shipTreeElementID`: an ordered list of the
// attributes shown for a group/faction/type in the in-game ship tree. The map
// key is kept as `slot` so ordering survives.
// ---------------------------------------------------------------------------

/// A ship-tree attribute such as Armor or Shield (shipTreeElements.yaml).
model ShipTreeElement {
  shipTreeElementId Int      @id
  name              String
  description       String?
  icon              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt()
  isDeleted         Boolean  @default(false)
}

/// Per-faction ship-tree presentation (shipTreeFactions.yaml), keyed by faction.
model ShipTreeFaction {
  factionId   Int                      @id
  description String?
  icon        String?
  elements    ShipTreeFactionElement[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt()
  isDeleted   Boolean                  @default(false)
}

/// An element shown for a faction (shipTreeFactions.yaml `elements`).
model ShipTreeFactionElement {
  factionId         Int
  shipTreeFaction   ShipTreeFaction @relation(fields: [factionId], references: [factionId])
  slot              Int
  shipTreeElementId Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt()
  isDeleted         Boolean         @default(false)

  @@id([factionId, slot])
}

/// A ship-tree group such as Corvette or Cruiser (shipTreeGroups.yaml). This is
/// the id `Type.shipTreeGroupId` points at.
model ShipTreeGroup {
  shipTreeGroupId Int                        @id
  name            String
  description     String?
  icon            String?
  iconLarge       String?
  iconSmall       String?
  iconSmallNpc    String?
  elements        ShipTreeGroupElement[]
  preReqSkills    ShipTreeGroupPreReqSkill[]
  tierThresholds  SkinrTierThreshold[]
  types           Type[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt()
  isDeleted       Boolean                    @default(false)
}

/// An element shown for a ship-tree group (shipTreeGroups.yaml `elements`).
model ShipTreeGroupElement {
  shipTreeGroupId   Int
  shipTreeGroup     ShipTreeGroup @relation(fields: [shipTreeGroupId], references: [shipTreeGroupId])
  slot              Int
  shipTreeElementId Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt()
  isDeleted         Boolean       @default(false)

  @@id([shipTreeGroupId, slot])
}

/// A skill prerequisite for a ship-tree group, per faction
/// (shipTreeGroups.yaml `preReqSkills.<factionID>.skills.<typeID>`).
model ShipTreeGroupPreReqSkill {
  shipTreeGroupId Int
  shipTreeGroup   ShipTreeGroup @relation(fields: [shipTreeGroupId], references: [shipTreeGroupId])
  factionId       Int
  skillTypeId     Int
  level           Int?
  display         Boolean?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt()
  isDeleted       Boolean       @default(false)

  @@id([shipTreeGroupId, factionId, skillTypeId])
}

/// The ship-tree elements shown for a specific type (typeElements.yaml).
model TypeElement {
  typeId            Int
  slot              Int
  shipTreeElementId Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt()
  isDeleted         Boolean  @default(false)

  @@id([typeId, slot])
}

// ---------------------------------------------------------------------------
// Graphic material sets (graphicMaterialSets.yaml)
// ---------------------------------------------------------------------------

/// A Space-Object-Factory material set — the hull/pattern materials and tint
/// colours applied to a ship graphic. This is the id `Graphic.sofMaterialSetId`
/// and `SkinMaterial.materialSetId` point at. The four RGBA colour objects are
/// flattened into prefixed columns, as MetaGroup does for `color`.
model GraphicMaterialSet {
  materialSetId   Int       @id
  description     String?
  sofFactionName  String?
  sofRaceHint     String?
  sofPatternName  String?
  resPathInsert   String?
  material1       String?
  material2       String?
  material3       String?
  material4       String?
  customMaterial1 String?
  customMaterial2 String?
  colorHullR      Float?
  colorHullG      Float?
  colorHullB      Float?
  colorHullA      Float?
  colorPrimaryR   Float?
  colorPrimaryG   Float?
  colorPrimaryB   Float?
  colorPrimaryA   Float?
  colorSecondaryR Float?
  colorSecondaryG Float?
  colorSecondaryB Float?
  colorSecondaryA Float?
  colorWindowR    Float?
  colorWindowG    Float?
  colorWindowB    Float?
  colorWindowA    Float?
  graphics        Graphic[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt()
  isDeleted       Boolean   @default(false)
}

// ---------------------------------------------------------------------------
// Military campaigns (militaryCampaigns.yaml, militaryCampaignObjectives.yaml)
//
// Both files are keyed by UUID, so the primary keys are String.
// ---------------------------------------------------------------------------

/// A faction military campaign (militaryCampaigns.yaml).
model MilitaryCampaign {
  militaryCampaignId String                       @id
  title              String
  subtitle           String?
  targetProgress     Int?
  /// factions.yaml id of the issuing faction (`issuer.factionID`).
  issuerFactionId    Int?
  annotations        MilitaryCampaignAnnotation[]
  objectives         MilitaryCampaignObjective[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt()
  isDeleted          Boolean                      @default(false)
}

/// A presentation annotation on a campaign (militaryCampaigns.yaml
/// `annotations`). CCP ships ~44 of these per campaign — mostly `res:/…` asset
/// paths plus a few localized blurbs — and adds more over time, so they are
/// stored key/value (English text for localized entries) rather than as one
/// column per key.
model MilitaryCampaignAnnotation {
  militaryCampaignId String
  militaryCampaign   MilitaryCampaign @relation(fields: [militaryCampaignId], references: [militaryCampaignId])
  key                String
  value              String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt()
  isDeleted          Boolean          @default(false)

  @@id([militaryCampaignId, key])
}

/// One objective within a campaign (militaryCampaignObjectives.yaml). The
/// `rewards` and `annotations` sub-objects have a small fixed key set, so they
/// are flattened into prefixed columns.
model MilitaryCampaignObjective {
  militaryCampaignObjectiveId     String                               @id
  title                           String
  subtitle                        String?
  /// militaryCampaigns.yaml id (`campaignID`).
  militaryCampaignId              String
  militaryCampaign                MilitaryCampaign                     @relation(fields: [militaryCampaignId], references: [militaryCampaignId])
  careerPath                      String?
  targetProgress                  Int?
  maxProgressPerParticipant       Int?
  /// npcCharacters.yaml id.
  presentingCharacterId           Int?
  /// npcCorporations.yaml id (`issuer.corporationID`).
  issuerCorporationId             Int?
  // rewards.isk / rewards.lp / rewards.standing
  iskAmountPerInterval            Float?
  iskProgressInterval             Int?
  iskIssuerCorporationId          Int?
  lpAmountPerInterval             Float?
  lpProgressInterval              Int?
  lpIssuerCorporationId           Int?
  standingGainPercentPerInterval  Float?
  standingProgressInterval        Int?
  /// The standing reward's issuer is a FACTION, not a corporation: CCP ships
  /// `rewards.standing.issuer.factionID` (isk/lp use `issuer.corporationID`).
  standingIssuerFactionId         Int?
  // annotations.*
  requiredEnlistmentWithFactionId Int?
  restrictionTooltip              String?
  warning1                        String?
  warning2                        String?
  /// contributionMethodConfiguration.name, e.g. "CompleteAgentMission".
  contributionMethodName          String?
  contentTags                     MilitaryCampaignObjectiveTag[]
  parameters                      MilitaryCampaignObjectiveParameter[]
  createdAt                       DateTime                             @default(now())
  updatedAt                       DateTime                             @updatedAt()
  isDeleted                       Boolean                              @default(false)

  @@index([militaryCampaignId])
}

/// A content tag on an objective (militaryCampaignObjectives.yaml `contentTags`).
model MilitaryCampaignObjectiveTag {
  militaryCampaignObjectiveId String
  objective                   MilitaryCampaignObjective @relation(fields: [militaryCampaignObjectiveId], references: [militaryCampaignObjectiveId])
  tag                         String
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt()
  isDeleted                   Boolean                   @default(false)

  @@id([militaryCampaignObjectiveId, tag])
}

/// A parameter of an objective's contribution method
/// (`contributionMethodConfiguration.parameters[].key`).
model MilitaryCampaignObjectiveParameter {
  militaryCampaignObjectiveId String
  objective                   MilitaryCampaignObjective                 @relation(fields: [militaryCampaignObjectiveId], references: [militaryCampaignObjectiveId])
  paramKey                    String
  matcherValues               MilitaryCampaignObjectiveParameterValue[]
  createdAt                   DateTime                                  @default(now())
  updatedAt                   DateTime                                  @updatedAt()
  isDeleted                   Boolean                                   @default(false)

  @@id([militaryCampaignObjectiveId, paramKey])
}

/// One matcher value for a contribution-method parameter
/// (`parameters[].matcher.values[]`). Ordinal keys, like
/// DogmaEffectModifier.modifierIndex: a matcher entry can carry a `valueType`
/// with no `values`, so neither field is safe as part of the key.
model MilitaryCampaignObjectiveParameterValue {
  militaryCampaignObjectiveId String
  paramKey                    String
  parameter                   MilitaryCampaignObjectiveParameter @relation(fields: [militaryCampaignObjectiveId, paramKey], references: [militaryCampaignObjectiveId, paramKey])
  matcherIndex                Int
  valueIndex                  Int
  valueType                   String
  value                       String?
  createdAt                   DateTime                           @default(now())
  updatedAt                   DateTime                           @updatedAt()
  isDeleted                   Boolean                            @default(false)

  @@id([militaryCampaignObjectiveId, paramKey, matcherIndex, valueIndex])
}

// ---------------------------------------------------------------------------
// SKINR — the in-game SKIN designer (skinr*.yaml, 9 files)
//
// Components (materials/patterns) are placed into slots; a slot configuration
// says which slots a hull exposes. Point values and tier thresholds drive the
// designer's cost/tier maths, and are keyed by (category, rarity) and
// (shipTreeGroup, tier) respectively — the SDE ships them as bare numeric maps.
// ---------------------------------------------------------------------------

/// A SKINR component category — Material, Pattern, Metallic
/// (skinrComponentCategories.yaml). `name` is a plain internal string here.
model SkinrComponentCategory {
  skinrComponentCategoryId Int                        @id
  name                     String
  components               SkinrComponent[]
  pointValues              SkinrComponentPointValue[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt()
  isDeleted                Boolean                    @default(false)
}

/// A SKINR component rarity tier (skinrComponentRarities.yaml).
model SkinrComponentRarity {
  skinrComponentRarityId Int                        @id
  name                   String
  rank                   Int?
  components             SkinrComponent[]
  pointValues            SkinrComponentPointValue[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt()
  isDeleted              Boolean                    @default(false)
}

/// Designer point cost per (category, rarity) (skinrComponentPointValues.yaml,
/// a bare `rarity -> points` map keyed by category).
model SkinrComponentPointValue {
  skinrComponentCategoryId Int
  category                 SkinrComponentCategory @relation(fields: [skinrComponentCategoryId], references: [skinrComponentCategoryId])
  skinrComponentRarityId   Int
  rarity                   SkinrComponentRarity   @relation(fields: [skinrComponentRarityId], references: [skinrComponentRarityId])
  points                   Int
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt()
  isDeleted                Boolean                @default(false)

  @@id([skinrComponentCategoryId, skinrComponentRarityId])
  @@index([skinrComponentRarityId])
}

/// A SKINR component — one material or pattern (skinrComponents.yaml). The
/// `sequenceBinder` sub-object is flattened into prefixed columns.
model SkinrComponent {
  skinrComponentId         Int                    @id
  name                     String
  skinrComponentCategoryId Int
  category                 SkinrComponentCategory @relation(fields: [skinrComponentCategoryId], references: [skinrComponentCategoryId])
  skinrComponentRarityId   Int
  rarity                   SkinrComponentRarity   @relation(fields: [skinrComponentRarityId], references: [skinrComponentRarityId])
  published                Boolean?
  finish                   String?
  iconFile                 String?
  resourceFile             String?
  projectionTypeU          String?
  projectionTypeV          String?
  /// sequenceBinder.itemTypeID / .count — the item and quantity consumed.
  sequenceBinderItemTypeId Int?
  sequenceBinderCount      Int?
  associatedTypes          SkinrComponentType[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt()
  isDeleted                Boolean                @default(false)

  @@index([skinrComponentCategoryId])
  @@index([skinrComponentRarityId])
}

/// A type that grants/uses a SKINR component
/// (skinrComponents.yaml `associatedTypeIds[]`).
model SkinrComponentType {
  skinrComponentId   Int
  skinrComponent     SkinrComponent @relation(fields: [skinrComponentId], references: [skinrComponentId])
  typeId             Int
  /// -1 means unlimited uses.
  licenseUsesGranted Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt()
  isDeleted          Boolean        @default(false)

  @@id([skinrComponentId, typeId])
}

/// A SKINR slot category (skinrSlotCategories.yaml).
model SkinrSlotCategory {
  skinrSlotCategoryId Int         @id
  name                String
  slots               SkinrSlot[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt()
  isDeleted           Boolean     @default(false)
}

/// An internal slot name (skinrSlotNames.yaml), e.g. `primary_nanocoating`.
model SkinrSlotName {
  skinrSlotNameId Int      @id
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt()
  isDeleted       Boolean  @default(false)
}

/// A SKINR slot (skinrSlots.yaml).
model SkinrSlot {
  skinrSlotId                Int                          @id
  name                       String
  skinrSlotCategoryId        Int?
  category                   SkinrSlotCategory?           @relation(fields: [skinrSlotCategoryId], references: [skinrSlotCategoryId])
  allowedComponentCategories SkinrSlotAllowedCategory[]
  configurationSlots         SkinrSlotConfigurationSlot[]
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt()
  isDeleted                  Boolean                      @default(false)

  @@index([skinrSlotCategoryId])
}

/// A component category a slot accepts
/// (skinrSlots.yaml `allowedDesignComponentCategories[]`).
model SkinrSlotAllowedCategory {
  skinrSlotId              Int
  skinrSlot                SkinrSlot @relation(fields: [skinrSlotId], references: [skinrSlotId])
  skinrComponentCategoryId Int
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt()
  isDeleted                Boolean   @default(false)

  @@id([skinrSlotId, skinrComponentCategoryId])
}

/// A named set of slots offered to a group of hulls
/// (skinrSlotConfigurations.yaml).
model SkinrSlotConfiguration {
  skinrSlotConfigurationId Int                          @id
  name                     String
  priority                 Int?
  /// When true the configuration applies to every ship and `ships` is empty.
  allowAllShips            Boolean?
  slots                    SkinrSlotConfigurationSlot[]
  ships                    SkinrSlotConfigurationShip[]
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt()
  isDeleted                Boolean                      @default(false)
}

/// A slot included in a configuration (skinrSlotConfigurations.yaml `config[]`).
model SkinrSlotConfigurationSlot {
  skinrSlotConfigurationId Int
  configuration            SkinrSlotConfiguration @relation(fields: [skinrSlotConfigurationId], references: [skinrSlotConfigurationId])
  skinrSlotId              Int
  skinrSlot                SkinrSlot              @relation(fields: [skinrSlotId], references: [skinrSlotId])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt()
  isDeleted                Boolean                @default(false)

  @@id([skinrSlotConfigurationId, skinrSlotId])
  @@index([skinrSlotId])
}

/// A hull a configuration applies to (skinrSlotConfigurations.yaml `ships[]`).
model SkinrSlotConfigurationShip {
  skinrSlotConfigurationId Int
  configuration            SkinrSlotConfiguration @relation(fields: [skinrSlotConfigurationId], references: [skinrSlotConfigurationId])
  typeId                   Int
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt()
  isDeleted                Boolean                @default(false)

  @@id([skinrSlotConfigurationId, typeId])
}

/// Points needed to reach a SKIN tier, per ship-tree group
/// (skinrTierThresholds.yaml, a bare `tier -> points` map keyed by
/// shipTreeGroupID).
model SkinrTierThreshold {
  shipTreeGroupId Int
  shipTreeGroup   ShipTreeGroup @relation(fields: [shipTreeGroupId], references: [shipTreeGroupId])
  tier            Int
  points          Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt()
  isDeleted       Boolean       @default(false)

  @@id([shipTreeGroupId, tier])
}
