{
  "name": "@jitaspace/ship-tree",
  "description": "Adapter that fits @eve-online-tools/eve-ship-tree (the in-game ship tree) into JitaSpace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./factions": "./factions.ts",
    "./server": "./server.ts",
    "./postcss": "./postcss.cjs"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules dist",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "pnpm lint --fix",
    "test": "jest --config ./jest.config.ts",
    "test:watch": "jest --config ./jest.config.ts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@eve-online-tools/eve-ship-tree": "0.3.0",
    "@mantine/core": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "@use-gesture/react": "^10.3.1",
    "motion": "^12.41.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@jitaspace/eslint-config": "workspace:*",
    "@jitaspace/prettier-config": "workspace:*",
    "@jitaspace/tsconfig": "workspace:*",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "prettier": "@jitaspace/prettier-config"
}
