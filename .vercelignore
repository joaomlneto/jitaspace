# Paths the Vercel CLI must not walk when uploading a deployment from a local
# checkout. Git-triggered deployments are unaffected: everything listed here is
# untracked, so a server-side clone never contains it.
#
# `.claude/worktrees` is the reason this file exists — agent worktrees are full
# repo checkouts with their own node_modules, and a few of them push the local
# tree past 3.5M files, which overflows the 10MB limit on the create-deployment
# request body ("Request body too large"). It is excluded via .git/info/exclude,
# which is local to git and not something Vercel reads.
.claude/worktrees

# Build output and caches.
node_modules
.next
.turbo
coverage
