{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env"],
  "ui": "tui",
  "globalEnv": [
    "CRON_SECRET",
    "DATABASE_URL",
    "DISCORD_BOT_TOKEN",
    "DISCORD_APPLICATION_ID",
    "DISCORD_PUBLIC_KEY",
    "DISCORD_UPDATES_CHANNEL_ID",
    "ENABLE_EXPERIMENTAL_COREPACK",
    "EVE_CLIENT_ID",
    "EVE_CLIENT_SECRET",
    "HISTORY_DATABASE_SCHEMA",
    "HISTORY_DATABASE_URL",
    "LOGTAIL_SOURCE_TOKEN",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "NEXT_PUBLIC_DISCORD_INVITE_LINK",
    "NEXT_PUBLIC_GOOGLE_TAG_ID",
    // A NEXT_PUBLIC_* var read only by apps/web does NOT belong here: turbo
    // infers that package as `nextjs` and hashes the whole prefix for it, so a
    // globalEnv entry only adds the var to the other 25 packages' hashes,
    // turning over caches that never saw the value. Delivery is not a reason
    // either way — turbo passes NEXT_* through to every task process under
    // envMode strict, declared or not. SENTRY_DSN stays for a different
    // reason: packages/background-jobs-triggerdev reads it (src/trigger/
    // init.ts:12) and has no `next` dependency, so eslint-plugin-turbo does
    // not infer it either, and without this entry the
    // turbo/no-undeclared-env-vars rule fails `pnpm lint`.
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_UMAMI_WEBSITE_ID",
    "REDIS_URL",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "ANTHROPIC_API_KEY",
    "SKIP_BUILD_STATIC_GENERATION",
    "SKIP_ENV_VALIDATION",
    "TRIGGER_API_URL",
    "TRIGGER_PROJECT_REF",
    "TRIGGER_SECRET_KEY"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_URL",
    "TRIGGER_VERSION",
    // Set by Next.js itself to identify the runtime ("nodejs" | "edge"), not
    // supplied by us — pass it through rather than hashing it. Surfaced by
    // turbo/no-undeclared-env-vars once env.ts came back under lint.
    "NEXT_RUNTIME",
    "npm_lifecycle_event"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "cache": false
    },
    "db:generate:watch": {
      "inputs": ["prisma/schema.prisma"],
      "cache": false
    },
    "db:push": {
      "inputs": ["prisma/schema.prisma"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^db:generate", "kubb:generate"],
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate", "^db:generate", "kubb:generate"],
      // No `inputs` override: Turbo's default hashes every git-tracked file in
      // the package, which is what a build actually depends on. The previous
      // narrowing to ts/tsx/package.json/tsconfig.json silently excluded CSS
      // modules, `public/`, and next.config.mjs (the CSP, security headers and
      // redirects) — so a commit touching only those produced an identical hash,
      // hit the remote cache, and restored a `.next` that predated the change.
      // Vercel builds through this task, so that shipped to production.
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts", "dist/**"]
    },
    "format": {
      // No `outputs`: no format script passes --cache/--cache-location, so the
      // previously declared .prettiercache was never written. Declaring an
      // output that never materialises makes a cache hit restore nothing while
      // still skipping the script.
      "outputLogs": "new-only"
    },
    "lint": {
      // Same codegen edges as `build` and `type-check`: tooling/eslint/base.ts
      // sets `projectService: true`, so linting is fully type-aware and reads
      // the same generated Prisma client and Kubb clients they do. Without
      // these, a clean checkout lints against missing types and reports
      // `no-unsafe-*` on every `prisma.*` call.
      "dependsOn": [
        "^topo",
        "db:generate",
        "^db:generate",
        "kubb:generate",
        "^kubb:generate"
      ],
      // Unnarrowed for the same reason: ESLint also covers .mjs/.cjs sources
      // (e.g. apps/web/scripts/*.mjs), which the previous list excluded.
      "outputs": ["node_modules/.cache/.eslintcache"]
    },
    "lint:fix": {},
    "analyze": {},
    "clean": {
      "cache": false
    },
    // Not a kubb task at all: the script is `tsx scripts/generate-scopes.ts`,
    // and this package has neither a kubb.config.ts nor a swagger.json. Under
    // the shared task's `inputs` no file matched, so the hash was constant and
    // the task was a permanent cache hit — bumping the pinned ESI spec left the
    // scope tables stale while reporting success. Declare what it actually
    // reads, including the sibling package's spec via $TURBO_ROOT$.
    "@jitaspace/esi-metadata#kubb:generate": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": [
        "scripts/generate-scopes.ts",
        "src/scopes/descriptions.ts",
        "$TURBO_ROOT$/packages/esi-client/swagger.json"
      ],
      "outputs": [
        "src/scopes/scopes.generated.ts",
        "src/scopes/endpoints.generated.ts"
      ]
    },
    "@jitaspace/hooks#kubb:generate": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "kubb:generate": {
      "dependsOn": ["^build", "^db:generate"],
      // `src/buildscript.js` produces the declared `src/build-data.json`
      // output, so a change to it must invalidate the task.
      "inputs": ["kubb.config.ts", "swagger.json", "src/buildscript.js"],
      "outputs": ["src/generated/**", "src/build-data.json"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["kubb:generate", "^kubb:generate"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      // `db:generate` for the same reason `build` depends on it: the Prisma
      // client is generated, gitignored, and its types are what `@jitaspace/db`
      // and everything downstream is checked against.
      "dependsOn": [
        "^topo",
        "db:generate",
        "^db:generate",
        "kubb:generate",
        "^kubb:generate"
      ],
      // Also unnarrowed: the base tsconfig sets `checkJs` and apps/web includes
      // ".", so .mjs/.cjs files are in the program — a type error in
      // next.config.mjs would otherwise be masked by a cache hit.
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    },
    "deploy": {
      "dependsOn": ["^db:generate", "^build"],
      "cache": false
    }
  }
}
