# declares `swagger.json` in the `kubb:generate` task's `inputs`, so
# reformatting them rewrites ~5,000 lines of whitespace and invalidates the
# Kubb cache for every generated client. Fetched verbatim by each package's
# `download-schema` script — keep them byte-identical to upstream.
**/swagger.json

# Generated code: kubb clients, Prisma clients, and the ESI build metadata kubb
# writes. Prettier only reads the ROOT .gitignore, so the per-package .gitignore
# files that already exclude these do not reach it.
**/src/generated/
**/prisma/generated/
packages/esi-client/src/build-data.json

# Build output and caches not already covered by .gitignore.
**/.next/
**/dist/
**/coverage/
